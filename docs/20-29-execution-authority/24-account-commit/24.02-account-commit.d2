    height: 34
  }
}
quint: QUINT\nSplit writes / lost replies / new-ID retries\nShared-account races / mixed snapshots / old owners {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nAtomic record and delta / original hold retention\nActual reconciliation join / conserved account total {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> registry.query
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.fence { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.join -> recovery.fence
recovery.fence -> broker.cas
broker.cas -> broker.alias
broker.alias -> broker.hold
broker.hold -> broker.cas: Read back the same immutable result { style.stroke-dash: 4 }

