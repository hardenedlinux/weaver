# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / ATOMIC ACCOUNT COMMIT / ORIGINAL RESERVATION {
  class: title
  near: top-center
}
protocols: GO / CLOUD NATIVE PROPOSALS {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Original outcome readback\nLost response / reconnect / retry\nNo independent balance mutation {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Attributable terminal and final usage\nExact original source applications\nUnknown usage keeps its hold {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Owner lifecycle and recovery\nOld proposals remain inert\nResolve the same application ID {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / SEMANTIC CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original financial effect\nClaim / profile / account / reservation\nBound / final usage / source bindings {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy at commit\nExact current effect and state\nOwner / source generation / policy {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Reservation conservation\nFinal usage plus unused remainder\nNew application ID cannot reset hold {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / ACCOUNT COMMIT OWNER {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Recheck original evidence join\nSource terminal and final usage\nCurrent owner and complete image {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Prepare an inert account proposal\nExact before-image and stable IDs\nNo financial effect from preparation {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: One durable account commit CAS\nUnique application and reservation\nConsume hold and commit balance delta {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: DURABLE AUTHORITY / PROJECTION {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Immutable original commit record\nApplication ID and balance after-image\nProtected prefix survives local restore {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Recover the complete current image\nApplications / holds / balances / fences\nMixed or old snapshots stay closed {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Qualified balance visibility\nReplay the same committed result\nNo second financial delta or send {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
