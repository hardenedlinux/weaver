...@../../../dev/d2/themes/flow
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / CURRENT JOIN / ONE ORIGINAL QUEUE OPERATION {
  class: title
  near: top-center
}
protocols: GO / SDK AND PROTOCOL ADAPTERS {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Original immutable operation\nMCP / A2A / Client ACP / SDK\nPreserve source key and range slot {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Retry and redirect proposals\nQuery original durable admission\nNo direct provider bypass {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Cloud-native recovery\nRetain original pending and exposure\nOld receipt is historical data {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / SEMANTIC CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original semantic binding\nClaim / profile / budget / history\nExact payload / route / range {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy\nCurrent enqueue action and state\nOriginal scope / lifetime / revocation {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Admission-only source transitions\nRoot offers / child calls / dispatches\nCommit cannot perform external I/O {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / ATOMIC FINAL ADMISSION {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Complete current projection join\nExact source and account result images\nEarlier join read is an observation {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: One final admission CAS\nJoin + Policy + owner + queue revision\nOperation key + canonical slot claim {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Qualified current owner and prefix\nNew commit or handover retires permit\nFresh permit still checks original slot {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / ORIGINAL BROKER OPERATION {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Durable original queue record\nAtomic slot and outcome registration\nLost acknowledgment uses lookup {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  claim: Separate protected range executor\nCurrent fence and effective Policy\nEnqueue has zero provider invocations {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Bounded original local offer\nSDK retry cannot duplicate a range\nUnknown outcome keeps original hold {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nCommit after join / owner switch / Policy change\nSDK retry / fresh key / admission-side send {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nActual admission-only source / atomic current gate\nImmutable slot / initialized broker composition {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> recovery.fence
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.projection { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.fence -> recovery.join { style.stroke-dash: 4 }
recovery.join -> broker.cas
broker.cas -> broker.claim
broker.claim -> broker.hold

