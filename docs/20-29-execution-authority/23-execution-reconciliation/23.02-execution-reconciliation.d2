...@../../../dev/d2/themes/flow
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / EXECUTION EVIDENCE / ORIGINAL RESERVATION {
  class: title
  near: top-center
}
protocols: GO / ATTRIBUTABLE OBSERVATIONS {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Original call and SDK outcome\nCancellation / timeout / reconnect\nObservations carry original identity {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Separate evidence classes\nRange progress / call terminal / usage\nNo inference from local zero calls {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Cloud native lifecycle recovery\nResolve original pending outcome\nRetry never resets the reservation {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / SEMANTIC CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original semantic contract\nClaim / profile / exact dispatch range\nBudget / history / reservation binding {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy at each CAS\nResolve / reconcile / meter / settle\nAuthenticate actual evidence and state {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Distinct semantic conclusions\nNo-execution / terminal / final usage\nUnknown retains original exposure {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / EXECUTION EVIDENCE {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Close original execution rights\nSerialize with final possible offer\nOld workers cannot release callbacks {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Qualified dispatch prefix\nNo burn + no submit + no invocation\nOtherwise preserve possible execution {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: One immutable original resolution\nComplete absence or call terminal\nLate observations remain original data {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / SOURCE AND ACCOUNT {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Source terminal application CAS\nExact original resolution and owner\nCommit and projection never send {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Final usage application CAS\nTerminal alone cannot price usage\nLate usage cannot overwrite a decision {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Original account application CAS\nCharge usage / release proven remainder\nLost response resolves the same result {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nSource zero / late receipts / partial snapshots\nLost responses / old owners / duplicate applications {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nActual executor and source ledger composition\nSealed absence / retained unknown / conserved budget {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> registry.query
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.fence { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.join -> recovery.fence
recovery.fence -> broker.cas
broker.cas -> broker.alias
broker.alias -> broker.hold
broker.hold -> broker.cas: Recover exact original applications { style.stroke-dash: 4 }
