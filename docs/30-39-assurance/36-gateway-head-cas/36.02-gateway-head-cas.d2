...@../../../dev/d2/themes/flow
# AI Agent Gateway core only. Runtime evidence stays in the Org receipt.
title: AI AGENT GATEWAY / LOGICAL AUTHORITY / FINAL MEDIATED SEND {
  class: title
  near: top-center
}
semantic: SCHEME / POLICY SEMANTICS {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  intent: Original canonical operation\nAgent / request / claim / payload\nShared budget and history identity {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  policy: Cedar / Code as Policy\nAuthorize actual effect and state\nProvider / model / method / route {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  unknown: Unknown keeps original obligations\nNo fresh root from retry or reconnect\nNo automatic budget refund {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
}
cloud: GO / CLOUD AND PROVIDER ADAPTERS {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  adapter: Go / cloud-native agent adapters\nKubernetes lifecycle / SDK shaping\nAll outbound attempts use the broker {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  observe: Observe head / bind durable job\nHead / revision / session / fence\nFinal CAS rechecks the bound view {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  recover: Recover the same original outcome\nLost reply is not an abort\nReconcile before any new attempt {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
ledger: DURABLE DECISION / PROJECTION {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#faf9fd"
  style.stroke: "#b0a7c8"
  cas: One original-root CAS decision\nCompare full current head and fence\nImmutable canonical decision record {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  rows: Asynchronous committed projection\nIdempotent original metadata row\nA stored row is not send authority {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  join: Current authority and projection join\nExact decision prefix / broker session\nRecover after either lost response {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
}
broker: RUST / FINAL EXECUTION OWNER {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#a3b4c0"
  queue: Owned request and streaming queue\nOne mediated logical offer\nNo independent SDK retry transport {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  gate: Final logical send gate\nExact payload / route / live Policy\nOriginal claim / nonce / budget / history {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Broker restart or head change\nAdvance execution session and fence\nReject stale queued authority {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nStale heads / lost commit replies / projection rollback / SDK retry counterexamples {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nUnique root decision / current CAS / original claim and shared budget {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
semantic.intent -> cloud.adapter
semantic.policy -> cloud.observe
cloud.adapter -> cloud.observe
cloud.observe -> ledger.cas
ledger.cas -> ledger.rows
ledger.rows -> ledger.join
cloud.recover -> ledger.join
ledger.join -> broker.queue
broker.queue -> broker.gate
broker.fence -> ledger.join: re-read {
  style.stroke-dash: 4
}

