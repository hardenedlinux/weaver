  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  manifest: Accept exact immutable floor intent\nOriginal cut / worker / context fence\nPersist original accepted obligation {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  isolation: Serialize commit and context fence\nCommit first keeps original history\nFence first retains the locked intent {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  callback: Read complete deciding image\nExact result and recovery session\nLate reply cannot relabel a decision {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
}
owner: RUST / ACTUAL RELEASE BOUNDARY {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#faf9fd"
  style.stroke: "#b0a7c8"
  certificate: Reset quarantines actual output\nOld FD / DMA / queued digest paths\nNo old-context commit after fence {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
