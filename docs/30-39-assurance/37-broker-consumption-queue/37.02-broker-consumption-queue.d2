# AI Agent Gateway core only. Runtime evidence stays in the Org receipt.
title: AI AGENT GATEWAY / DURABLE CONSUMPTION / FINAL QUEUE {
  class: title
  near: top-center
}
semantic: SCHEME / POLICY SEMANTICS {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  intent: Original operation and manifest\nAgent / claim / immutable payload\nShared budget and history identity {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  policy: Cedar / Code as Policy\nEvaluate bound operation and state\nProvider / model / method / route {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  unknown: Unknown retains original hold\nPartial write is not safe to replay\nNo automatic budget refund {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
}
cloud: GO / CLOUD AND PROVIDER ADAPTERS {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  adapter: Go / cloud-native agent adapters\nKubernetes lifecycle / SDK shaping\nAll outbound attempts use the broker {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  observe: Retry the original operation only\nNo SDK redirect or retry transport\nBackpressure and cancellation intents {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  recover: Resolve original bound receipts\nLate data cannot grant execution\nLocal write is not provider completion {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
ledger: DURABLE CONSUMPTION / HANDOFF {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#faf9fd"
  style.stroke: "#b0a7c8"
  cas: Consume the original admission\nCurrent claim / Policy / fence\nLost reply requires original lookup {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  rows: Persist canonical handoff intent\nSame original key and manifest\nIntent alone cannot authorize bytes {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  join: Durable deduplicated queue acceptance\nVerify prefix before reactivation\nUnknown acceptance keeps original slot {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
}
broker: RUST / FINAL EXECUTION OWNER {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#a3b4c0"
  queue: Reserve a bounded streaming range\nPersist interval before invocation\nOne consumed call slot per interval {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  gate: Final mediated write invocation\nExact manifest / route / live Policy\nCurrent owner and execution fence {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Write outcome and final settlement\nUnknown retains the original hold\nTerminal and usage before release {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nCommit and enqueue loss / SDK replay / partial writes / late receipt counterexamples {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nOriginal admission / disjoint ranges / single invocation / unknown retains hold {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
semantic.intent -> cloud.adapter
semantic.policy -> cloud.observe
cloud.adapter -> cloud.observe
cloud.observe -> ledger.cas
ledger.cas -> ledger.rows
ledger.rows -> ledger.join
cloud.recover -> ledger.join
ledger.join -> broker.queue
broker.queue -> broker.gate
broker.gate -> broker.fence
semantic.unknown -> cloud.recover: reconcile {
  style.stroke-dash: 4
}

