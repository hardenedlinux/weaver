...@../../../dev/d2/themes/flow
# Core ownership and protocol. Check receipts stay in Org.
title: PROTECTED COMMIT / MEDIATED KEY RELEASE / ORIGINAL EXECUTION {
  class: title
  near: top-center
}
semantic: SEMANTICS / CLOUD LIFECYCLE {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  identity: Scheme / canonical statement\nOriginal claim / budget / history\nCedar constrains the actual effect {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  lifecycle: Go / cloud-native orchestration\nDiscovery / reconcile / status lookup\nPod health grants no key authority {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  unknown: Unknown decision stays protected\nResolve the exact original request\nNo promise reset / replay / refund {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
transaction: PROTECTED PUBLICATION OWNER {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  stage: Immutable staged request\nExact body and expected predecessor\nStaging is not permission to sign {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  commit: Atomic protected publication\nCAS prefix promise and request row\nConcurrent conflicts cannot both win {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  resolve: Authentic commit observation\nLost response remains unknown\nKeep the original durable decision {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
}
signer: RUST / MEDIATED KEY BOUNDARY {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#faf9fd"
  style.stroke: "#b0a7c8"
  emission: Release the exact covered statement\nNo generic signing handle escapes\nIdentical retries may repeat safely {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  gate: Live key-boundary gate\nCommitted row / current session\nEligible nonretired signer only {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  recovery: Restart begins in quarantine\nRevoke old mediated sessions\nQualify from current protected state {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
outcome: ROOT / ORIGINAL FINAL EFFECT {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#a3b4c0"
  delivery: Original signature may arrive late\nDelivery cannot create a statement\nNo relabeling to a new context {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  root: Exact quorum certificate\nFull inherited data and control prefix\nSignature is not an execution permit {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: ledger
  }
  broker: Rust / final broker enforcement\nOriginal consumption and live Policy\nActual writer fence / original result {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
quint: QUINT\nLost commits / concurrent requests / restart and old raw-key failures {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nCommitted release / prefix agreement / original consumption and budget {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
semantic.identity -> transaction.stage
semantic.lifecycle -> transaction.stage
semantic.unknown -> transaction.resolve
transaction.stage -> transaction.commit
transaction.commit -> transaction.resolve
transaction.commit -> signer.gate
transaction.resolve -> signer.gate
signer.recovery -> signer.gate
signer.gate -> signer.emission
signer.emission -> outcome.delivery
outcome.delivery -> outcome.root
outcome.root -> outcome.broker

