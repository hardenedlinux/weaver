# Core ownership and flow only. Evidence and proof assumptions stay in Org.
title: ORIGINAL OBLIGATION / FENCED CONTINUATION / QUALIFIED RELEASE {
  class: title
  near: top-center
}
semantic: SEMANTICS / CLOUD RECONCILIATION {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  obligation: Scheme / immutable original obligation\nSame claim / budget / history domain\nCedar binds actual effect and state {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  cloud: Go / cloud-continuation_owner reconciliation\nRetry original root and status reads\nPod restart cannot create authority {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  unknown: Unknown obligations stay reserved\nNo replacement root / refund / replay\nMissing evidence remains closed {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: unknown
  }
  goBrand: "" {
    shape: image
