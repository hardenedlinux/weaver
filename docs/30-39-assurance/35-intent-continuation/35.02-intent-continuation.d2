}
semantic.obligation -> ledger.history
semantic.cloud -> ledger.head
ledger.history -> continuation_owner.cut
continuation_owner.cut -> ledger.head
ledger.head -> continuation_owner.fence
continuation_owner.fence -> ledger.commit
ledger.head -> semantic.unknown: retained {
  style.stroke-dash: 4
}
ledger.commit -> recovery.observe
recovery.observe -> recovery.progress
recovery.progress -> recovery.activate
recovery.activate -> continuation_owner.release

continuation_owner.fence -> continuation_owner.cut: new fence {
  style.stroke-dash: 4
}

