...@../../../dev/d2/themes/flow
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / BENEFICIARY KEY / AUTHORITATIVE ENROLLMENT {
  class: title
  near: top-center
}
protocols: GO / CLOUD NATIVE IDENTITY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Workload identity is eligibility only\nIndependent launch enrollment principal\nNo bearer first-writer authority {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Two proofs over the same transcript\nNew key / session / original template\nAuthenticate adapter-to-broker context {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Recover the original first binding\nCurrent read policy / same canonical root\nNo rebind or freshness from a reply {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / ORIGINAL CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original semantic commitment\nCanonical claim / profile / history\nReservation and retained tail {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy\nAuthenticate facts before evaluation\nCurrent approval at publication {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Historical proof is no live permission\nOriginal reservation remains bound\nRevocation must fence downstream {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / FIRST KEY REGISTRY {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Commit the enrollment entitlement root\nOriginal template / enrolled principal\nNo beneficiary grant yet {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Freeze the first key and session\nVerify enrollment and beneficiary proofs\nOne claim per canonical launch {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Restore the accepted enrollment prefix\nPreserve the first key and session\nNever trust a one-sided projection {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / INVITATION PUBLICATION {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: CAS binding / epoch / source parent\nPublish invitation and exact outcome\nOne durable authority association {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Publication never sends or activates\nOnly joined images can consume\nActivation and final send retain gates {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Epoch revocation crosses issuer fence\nRetain first binding and original outcome\nUnknown use keeps the budget hold {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
