# Core design only; source identities and proof receipts remain in Org.
...@../../architecture/diagrams/lib/theme
title: WEAVER / BOOTSTRAP INVITATION / BOUND ISSUANCE {
  class: title
  near: top-center
}
protocols: GO / CLOUD NATIVE IDENTITY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Shared workload is eligibility only\nProducer assigns the canonical launch\nFreeze the beneficiary key and session {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Forwarded bearer grants no identity\nProve the assigned key and channel\nNo future incarnation login {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Recover the original invitation result\nLost reply returns the same ticket\nNo new launch or deadline renewal {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / ORIGINAL CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original semantic commitment\nCanonical claim / profile / history\nReservation and retained tail {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy\nAuthentic current source facts\nBind the exact original operation {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Preserve original recovery duties\nUnknown usage retains its hold\nProjection applies no money {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / INVITATION AUTHORITY {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Publish immutable invitation binding\nCanonical launch / key / transcript\nShared workload is eligibility only {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: One consume and pending issue commit\nExact key / source parent / epoch\nNo activation or external send {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Recover the exact consumed outcome\nQualify the complete authority prefix\nHistorical replies grant no freshness {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / DETERMINING CAS {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Compare ticket / proof / epoch / parent\nRequire current recovery authorization\nOne determining activation CAS {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Activate grant and custody together\nRecord the original issuance outcome\nReject stale keys and repeated activation {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Keep unknown reservation intact\nNo refund from a missing projection\nFinal sending has its own gates {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nCredential forwarding / split commits / lost replies\nConcurrent consumption / restart / old workers {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nProducer provenance / one consumption / frozen key\nActual issuance and original budget composition {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> registry.query
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.fence { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.join -> recovery.fence
recovery.fence -> broker.cas
broker.cas -> broker.alias
broker.alias -> broker.hold
broker.hold -> broker.cas: Read current prefix { style.stroke-dash: 4 }
