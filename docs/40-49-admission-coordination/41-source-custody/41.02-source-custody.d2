...@../../../dev/d2/themes/data
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / RECOVERABLE SOURCE CUSTODY / FINAL ADMISSION {
  class: title
  near: top-center
}
protocols: GO / CLOUD NATIVE RECOVERY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Recover original task and intent\nReconnect without a new operation\nResolve lost commit responses {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Query current custody authority\nKeep original unknown obligations\nLocal leases grant no commit right {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Cloud native worker handoff\nDiscard cached admission tickets\nRetain original recovery references {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / ORIGINAL CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original task and semantic intent\nClaim / profile / history binding\nReservation and pending tail {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy\nAuthentic current operation facts\nReauthorize changed dependencies {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Preserve recovery obligations\nUnknown usage retains its hold\nCustody close applies no money {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / DURABLE CUSTODY {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Persist original intent and arm\nExact attempt and current join\nNo external send at publication {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Transfer through current authority\nAdvance custody fence durably\nPreserve intent / outcome / pins {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Resolve under the current fence\nOriginal result or fenced absence\nRevalidate before the next arm {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / DETERMINING CAS {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Compare current custody fence\nExact source / account / floor join\nPublish one original outcome {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Old holder rejected at actual CAS\nLost response recovers same result\nNo duplicate tail admission {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Keep unknown reservation intact\nCustody close is no usage receipt\nFinal sending has its own gates {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nCommit / transfer races and lost responses\nRestart / old permits / unknown outcomes {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nActual source join / floor / account composition\nCurrent custody / unique result / retained holds {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> registry.query
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.fence { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.join -> recovery.fence
recovery.fence -> broker.cas
broker.cas -> broker.alias
broker.alias -> broker.hold
broker.hold -> broker.cas: Refresh custody { style.stroke-dash: 4 }

