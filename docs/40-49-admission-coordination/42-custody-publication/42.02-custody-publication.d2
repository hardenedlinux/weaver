recovery: RUST / PROTECTED PUBLICATION {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Stage a typed original command\nBind the observed authority parent\nStaging admits no tail or send {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Append one protected event\nCustody fence and floor association\nOriginal outcome survives transfer {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Recover from the current prefix\nRebuild inactive projections\nEqual bytes do not prove freshness {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / DETERMINING CAS {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
