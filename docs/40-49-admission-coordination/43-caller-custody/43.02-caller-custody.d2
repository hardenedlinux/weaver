# Core design only; source identities and proof receipts remain in Org.
...@../../architecture/diagrams/lib/theme
title: WEAVER / CALLER INCARNATION / CUSTODY CAPABILITY {
  class: title
  near: top-center
}
protocols: GO / CLOUD NATIVE IDENTITY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Shared workload identity\nEnroll a distinct worker incarnation\nBind its own proof of possession {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Reconnect to the original operation\nRedeliver the same capability\nNo scope or deadline renewal {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Independent recovery authorization\nFresh incarnation on handoff\nOld worker cannot mint a grant {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
registry: SCHEME / ORIGINAL CONTRACT {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Original semantic commitment\nCanonical claim / profile / history\nReservation and retained tail {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Cedar Code as Policy\nAuthentic current source facts\nBind the exact original operation {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Preserve original recovery duties\nUnknown usage retains its hold\nProjection applies no money {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
recovery: RUST / AUTHENTIC CALLER {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Verify native peer context\nMatch incarnation and current key\nIgnore claimed identity fields {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Stage the original publication envelope\nGrant / custody / outcome association\nNo authority change or external send {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Read current grant and protected prefix\nRotate keys through the same CAS\nClear stale join and resolution {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / DETERMINING CAS {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Atomic final permit and parent check\nCurrent source / account / floor join\nAppend one grant and outcome event {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: Reject old incarnation / key / expiry\nLate replies confer no new right\nNo duplicate original admission {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Keep unknown reservation intact\nNo refund from a missing projection\nFinal sending has its own gates {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nShared identity / queued expiry / grant rotation\nLost replies / old workers / split publication {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nCaller binding / immutable scope / fresh incarnation\nActual publication and account composition {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
protocols.mcp -> registry.origin
protocols.a2a -> registry.alias
protocols.acp -> registry.query
registry.origin -> recovery.projection
registry.alias -> recovery.join
registry.query -> recovery.fence { style.stroke-dash: 4 }
recovery.projection -> recovery.join
recovery.join -> recovery.fence
recovery.fence -> broker.cas
broker.cas -> broker.alias
broker.alias -> broker.hold
broker.hold -> broker.cas: Read current prefix { style.stroke-dash: 4 }
