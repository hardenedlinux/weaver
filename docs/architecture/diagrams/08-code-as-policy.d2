# W08: compact enterprise reading order. Cedar and application admission stay distinct.
program: 01 / AUTHOR AND ACTIVATE {
  top: 0
  left: 0
  width: 340
  height: 610
  label.near: top-center
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  style.font-size: 18
  author: Scheme / POO owner\nDelegation and parent baseline {
    top: 75
    left: 40
    width: 260
    height: 64
    class: semantic
  }
  closure: Admitted artifact closure\nPolicy / schema / entities / code {
    top: 205
    left: 40
    width: 260
    height: 64
    class: policy
  }
  cloud: Go integration\nDistribute / report generation {
    top: 335
    left: 40
    width: 260
    height: 64
    class: cloud
  }
  activate: Runtime activation\nScope / features / rollback floor {
    top: 465
    left: 40
    width: 260
    height: 64
    class: runtime
  }
}
evaluate: 02 / EVALUATE AND ISSUE {
  top: 0
  left: 440
  width: 340
  height: 610
  label.near: top-center
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  style.font-size: 18
  input: Exact operation\nCurrent issued source admission {
    top: 75
    left: 40
    width: 260
    height: 64
    class: ledger
  }
  cedar: Existing Cedar Rust + Lean\nSame input / full diagnostics {
    top: 205
    left: 40
    width: 260
    height: 64
    class: policy
  }
  profile: Required execution gate\nAllow AND empty error IDs {
    top: 335
    left: 40
    width: 260
    height: 64
    class: verified
  }
  grant: Signed receipt / one-use grant\nProtected issue extension {
    top: 465
    left: 40
    width: 260
    height: 64
    class: policy
  }
}
execute: 03 / CONSUME AND ENFORCE {
  top: 0
  left: 880
  width: 340
  height: 610
  label.near: top-center
  style.fill: "#f7f9fc"
  style.stroke: "#9cacc2"
  style.font-size: 18
  consume: Original issuer\nConsume exact grant once {
    top: 75
    left: 40
    width: 260
    height: 64
    class: runtime
  }
  commit: S4 fenced ledger commit\nHistory / budget / audit / source {
    top: 205
    left: 40
    width: 260
    height: 64
    class: ledger
  }
  broker: S5 final broker\nClaim / final gate / one invocation {
    top: 335
    left: 40
    width: 260
    height: 64
    class: runtime
  }
  release: S6 response disclosure gate\nExact peer / range / premise {
    top: 465
    left: 40
    width: 260
    height: 64
    class: semantic
  }
}
reject: REJECT EXECUTABLE ADMISSION\nNo grant / abort only an existing unclaimed attempt {
  top: 730
  left: 435
  width: 480
  height: 70
  class: deny
}
program.author -> program.closure: Approve exact closure
program.closure -> program.cloud: Admitted publication
program.cloud -> program.activate: ACK is not activation
program.activate -> evaluate.input: Active closure
program.activate -> reject: Incompatible / unauthorized
evaluate.input -> evaluate.cedar: Exact subject
evaluate.cedar -> evaluate.profile: Preserve Cedar result
evaluate.profile -> evaluate.grant: All required checks pass
evaluate.grant -> execute.consume: Bound grant
execute.consume -> execute.commit: Positive consumption / not send authority
execute.commit -> execute.broker: Current claim premise
execute.broker -> execute.release: Upstream result is not release permission
rule: "A policy allow alone is not execution authority.\nScheme owns semantics; Go integrates cloud services; Rust enforces physical guards. Cedar is not the ledger or external effect proof." {
  shape: text
  class: note
  near: bottom-center
}
(program.activate -> reject)[0].style.stroke: "#bd4c60"
evaluate -> reject: Invalid / stale / missing witness / runtime failure / deny / errors / mismatch {
  style.stroke: "#bd4c60"
}

