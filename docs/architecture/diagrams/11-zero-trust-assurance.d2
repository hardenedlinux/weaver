...@../../../dev/d2/themes/assurance
# Independent evidence obligations; no implied implemented proof pipeline.
direction: down
title: ZERO TRUST / COMPOSING INDEPENDENT EVIDENCE {
  class: title
  near: top-center
}
foundation: ORIGINAL SEMANTIC CONTRACT\nScheme Governance / Cedar permission meaning\nGo observations / Rust execution / shared operation {
  shape: hexagon
  class: policy
}
model: QUINT / CONCURRENT BEHAVIOR {
  direction: down
  style.fill: "#F2EBF9"
  style.stroke: "#B7A4CC"
  state: Explicit states and actions\nConsume / commit / claim / send { class: runtime }
  faults: Concurrent fault schedules\nLate replies / restore / old workers { class: unknown }
  receipt: Reachable paths / counterexamples\nBounded interleaving evidence { class: semantic; shape: page }
}
proof: LEAN / PRESERVED MEANING {
  direction: down
  style.fill: "#EAF2FC"
  style.stroke: "#9AB3D4"
  meaning: Exact policy projection\nAuthenticated original inputs { class: cloud }
  relation: Guarded transition relation\nState / step / safety invariants { class: cloud }
  receipt: Conditional preservation\nProjection / refinement / original scope { class: cloud; shape: page }
}
execution: RUNTIME / ENFORCED PREMISES {
  direction: down
  style.fill: "#F8F2E7"
  style.stroke: "#CBBB9D"
  adapters: Scheme source / Go integration\nRust coordinator / ledger / broker { class: ledger }
  faults: Atomicity / logical broker custody\nStop / drain / receiver fencing { class: ledger }
  receipt: Actual execution boundary\nIdentity / custody / release / fencing { class: ledger; shape: page }
}
admit: PROTECTED EXECUTION CONTRACT\nLive source / current Policy / budget\nUnique original claim / final-send guards {
  shape: hexagon
  class: verified
}
foundation -> model.state: Behavioral obligations
foundation -> proof.meaning: Semantic obligations
foundation -> execution.adapters: Native refinement duties
model.state -> model.faults
model.faults -> model.receipt
proof.meaning -> proof.relation
proof.relation -> proof.receipt
execution.adapters -> execution.faults
execution.faults -> execution.receipt
model.faults -> proof.relation: Step relation { style.stroke-dash: 4 }
proof.relation -> execution.faults: Trace mapping { style.stroke-dash: 4 }
model.receipt -> admit: Concurrent safety
proof.receipt -> admit: Preservation
execution.receipt -> admit: Established premises
rule: "Quint exposes schedules. Lean preserves declared invariants. Runtime checks establish execution premises.\nNo evidence artifact replaces live authorization at the actual effect." {
  class: note
  shape: text
  near: bottom-center
}

