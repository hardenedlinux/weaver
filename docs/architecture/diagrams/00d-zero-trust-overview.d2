  "presentation": {
    "modelView": "WeaverViews::execution",
    "eyebrow": "WEAVER / ZERO TRUST EXECUTION",
    "heading": "Trust is checked at actual use.",
    "subtitle": "A route proposes. A current, bound decision governs external bytes.",
    "captions": [
      {
        "name": "WeaverViews::ExecutionOrder",
        "type": "",
        "label": "Final execution boundary",
        "icon": "rust"
      },
      {
        "name": "propose",
