        "label": "01  Propose\nGo: bound route",
        "icon": "go"
      },
      {
        "name": "reserve",
        "type": "WeaverExecution::Enqueue",
        "label": "02  Reserve + enqueue\nDurable intent + hold",
        "icon": "document"
      },
      {
        "name": "consume",
        "type": "WeaverExecution::Consume",
        "label": "03  Consume once\nClaim + Policy + fence",
        "icon": "decision"
      },
      {
        "name": "finalSend",
        "type": "WeaverExecution::GuardAndSend",
        "label": "04  Guard + release\nCurrent write authority",
        "icon": "capture"
      },
      {
        "name": "observe",
        "type": "WeaverExecution::RecoverOutcome",
        "label": "05  Observe / recover\nUnknown retains hold",
