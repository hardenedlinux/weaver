}
runtime: "" {
  top: 500
  left: 0
  width: 1180
  height: 360
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  brand: "" {
    shape: image
    icon: assets/rust.svg
    top: 8
    left: 15
    width: 30
    height: 30
  }
  adapter: Go or Rust ingress\nExact actor / target / payload {
    top: 70
    left: 35
    width: 240
    height: 70
