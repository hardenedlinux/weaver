...@../../../dev/d2/themes/flow
# Core identity and evidence boundaries. Proof receipts remain in Org.
title: LOGICAL MESSAGE / AUTHORITY DOES NOT RESET INTENT {
  class: title
  near: top-center
}
semantics: SEMANTICS / CLOUD INTEGRATION {
  top: 0
  left: 0
  width: 340
  height: 590
  label.near: top-center
  style.font-size: 18
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  intent: Scheme / canonical logical intent\nImmutable message / parent scope {
    top: 85
    left: 25
    width: 290
    height: 100
    class: semantic
  }
  policy: Cedar / permission meaning\nCurrent source / history constraints {
    top: 270
    left: 25
    width: 290
    height: 100
    class: policy
  }
  adapter: Go / cloud and protocol adapters\nStage input / report observations {
    top: 455
    left: 25
    width: 290
    height: 90
    class: cloud
  }
}
ledger: RUST / MESSAGE LEDGER {
  top: 0
  left: 470
  width: 400
  height: 590
  label.near: top-center
  style.font-size: 18
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  identity: Same logical key across issuers\nOriginal history / retained escrow {
    top: 85
    left: 35
    width: 330
    height: 100
    class: ledger
  }
  consume: Scoped issuance / spent state\nCurrent revision / atomic consumption {
    top: 270
    left: 35
    width: 330
    height: 100
    class: runtime
  }
  claim: Sticky claim / original stream\nFresh nonce cannot replace origin {
    top: 455
    left: 35
    width: 330
    height: 90
    class: ledger
  }
}
execution: RUST / BROKER AND EVIDENCE {
  top: 0
  left: 1000
  width: 390
  height: 590
  label.near: top-center
  style.font-size: 18
  style.fill: "#faf9fd"
  style.stroke: "#b0a7c8"
  offer: Original live stream only\nBounded offer / no reconnect replay {
    top: 85
    left: 30
    width: 330
    height: 100
    class: runtime
  }
  observation: Late outcome / original claim\nAppend evidence / never reopen send {
    top: 270
    left: 30
    width: 330
    height: 100
    class: unknown
  }
  accounting: Outcome / retirement / final cost\nSeparate facts / retain unknown hold {
    top: 455
    left: 30
    width: 330
    height: 90
    class: ledger
  }
}
quint: QUINT\nConcurrent transitions / counterexamples {
  top: 700
  left: 250
  width: 370
  height: 90
  class: policy
}
lean: LEAN\nInductive safety / explicit premises {
  top: 700
  left: 780
  width: 370
  height: 90
  class: semantic
}
semantics.intent -> ledger.identity: canonical meaning
semantics.policy -> ledger.consume: admitted binding
semantics.adapter -> execution.observation: scoped evidence
ledger.identity -> ledger.consume
ledger.consume -> ledger.claim
ledger.claim -> execution.offer: execution join
execution.offer -> execution.observation: may remain unknown
execution.observation -> execution.accounting
quint -> ledger.claim: model transitions {
  style.stroke-dash: 5
}
lean -> ledger.identity: preserve invariants {
  style.stroke-dash: 5
}

