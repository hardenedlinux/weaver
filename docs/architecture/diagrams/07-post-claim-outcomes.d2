...@../../../dev/d2/themes/state
# W07: facts about one spent claim, not a replayable send pipeline.
direction: down
claimed: DispatchClaimed\nOne possible invocation
final_gate: Final broker gate\nBytes / target / credential / expiry
retire: Pre-submission failure\nRetire handles and queues
invoke: Invocation may have started\nCrash leaves uncertainty
emitter: Potentially open emitter
closed: ClosedWithEvidence\nNo future submissions
no_submit: NoSubmissionProven\nClaim remains spent
unknown: Business outcome Unknown
result: Business result observed\nNot emitter closure
exposure: Held / UnknownExposure\nRetain admitted maximum
settle: Admit usage once\nAtomic fenced settlement
conflict: Disclosure conflict gate\nClose only with emitter evidence
claimed -> final_gate: Local handle
claimed -> exposure: Claim reply lost / crash\nNo replacement handle
final_gate -> retire: Local final check fails
retire -> no_submit: No-submission proof
final_gate -> invoke: Gate passes
invoke -> emitter: Submit once
invoke -> unknown: No attributable result
emitter -> closed: Closure proof
emitter -> result: Result can arrive before closure
closed -> conflict: Close this emission only
closed -> exposure: Usage may remain unknown
no_submit -> conflict: Proven closed emitter
no_submit -> settle: Release unused exposure only\nKeep claim spent
result -> settle: Usage evidence required
unknown -> exposure: No automatic refund
exposure -> settle: Later qualified usage evidence
rule: "result is not emitter closure; closure is not zero usage.\nObservation admission and settlement have distinct crash cuts.\nA timeout, error string or zero-byte counter is not no-submission proof." {
  shape: text
}

# Shared role accents; brand marks are confined to architecture headers.
claimed.class: runtime
final_gate.class: policy
retire.class: unknown
invoke.class: runtime
emitter.class: unknown
closed.class: verified
no_submit.class: verified
unknown.class: unknown
result.class: policy
exposure.class: ledger
settle.class: ledger
conflict.class: semantic
rule.class: note

# Explicit reading order; presentation coordinates are not protocol events.
