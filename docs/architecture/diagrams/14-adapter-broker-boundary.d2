# Core adapter/broker contract; no library defaults or qualification receipts.
...@lib/theme
title: POLICY-PRESERVING ADAPTER TO BROKER {
  class: title
  near: top-center
}
contract: Scheme / POO semantic contract\nExact projection / allowed transforms / recipient / stream obligations {
  top: 0
  left: 150
  width: 920
  height: 90
  class: semantic
}
adapter: GO / REQUEST ADAPTER {
  top: 230
  left: 0
  width: 360
  height: 660
  label.near: top-center
  style.font-size: 18
  style.fill: "#f7f9fc"
  style.stroke: "#9cacc2"
  brand: "" {
    shape: image
    icon: assets/go.svg
    top: 12
    left: 16
    width: 46
    height: 20
  }
  construct: Protocol / SDK construction\nNo upstream dial or credential {
    top: 70
    left: 25
    width: 310
    height: 86
    class: cloud
  }
  freeze: Immutable operation handoff\nActor / recipient / exact payload {
    top: 260
    left: 25
    width: 310
    height: 86
    class: cloud
  }
  units: Ranges of admitted message\nSequence / content / incarnation {
    top: 450
    left: 25
    width: 310
    height: 86
    class: cloud
  }
}
broker: RUST / CONSTRAINED EXECUTION {
  top: 230
  left: 580
  width: 430
  height: 660
  label.near: top-center
  style.font-size: 18
  style.fill: "#f8f9fc"
  style.stroke: "#a3abc0"
  brand: "" {
    shape: image
    icon: assets/rust.svg
    top: 10
    left: 12
    width: 30
    height: 30
  }
  authorize: Verify exact operation / Cedar checks\nConsume original scoped grant {
    top: 70
    left: 35
    width: 360
    height: 86
    class: policy
  }
  claim: Durable obligations / typed claim\nBound stream start or message {
    top: 220
    left: 35
    width: 360
    height: 86
    class: ledger
  }
  gate: Semantic / immutable-unit guard\nPeer / source cut / held capacity {
    top: 370
    left: 35
    width: 360
    height: 86
    class: runtime
  }
  submit: Controlled request / message submission\nNo retry / redirect / hedge / mirror {
    top: 520
    left: 35
    width: 360
    height: 86
    class: runtime
  }
}
upstream: Admitted upstream peer\nOne request / bounded stream {
  top: 750
  left: 1230
  width: 310
  height: 86
  class: ledger
}
refuse: Refuse follow-up or mismatched send\nClaim spent / retain unknown exposure {
  top: 450
  left: 1205
  width: 360
  height: 100
  class: deny
}
contract -> adapter: Projection / normalization
contract -> broker: Admitted meaning / obligations
adapter.construct -> adapter.freeze
adapter.freeze -> broker.authorize: Bound handoff
adapter.units -> broker.gate: Bound ranges / no send right
broker.authorize -> broker.claim
broker.claim -> broker.gate: Scoped local handle
broker.gate -> broker.submit: Only admitted request or range
broker.submit -> upstream: Actual application submission
broker.gate -> refuse: Mismatch / expired scope
upstream -> refuse: Redirect / retry proposal
rule: "Quint models route, retry, queue, partial-write and recovery interleavings. Lean preserves exact binding, unique start and bounded prefix authority.\nA route update, library retry, reconnect or cancellation never creates a new send right. Closure requires retirement of every delegated emitter." {
  shape: text
  class: note
  near: bottom-center
}
