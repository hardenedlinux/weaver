# W06: rejected preflight and three explicit owner-extension stages.
preflight: Existing preflight\nDecision state / outcome = unknown {
  top: 80
  left: 0
  width: 280
  height: 90
  class: unknown
}
refusal: Ordinary protected path refuses\nNo marker stripping or flag weakening {
  top: 270
  left: 0
  width: 280
  height: 90
  class: deny
}
