  }
}
preflight -> refusal: Not executable authority
admit.decision -> admit.issued: Issued identity / no caller-made allow
admit.issued -> admit.binding: Original validity / exact subject
admit.binding -> verify.trusted: Authenticated designated role
verify.trusted -> verify.dual
verify.dual -> verify.post: No error-bearing executable result
verify.post -> use.grant: Complete eligible result only
use.grant -> use.consume: Same fixed binding / no expiry extension
use.consume -> use.ledger: Positive response is necessary\nNot sufficient to send
rule: "latest-state semantics require an actual guarded source contract.\nImmutable snapshots are not latest-state claims. New evaluated admission, protected issue and phase guards need owner qualification." {
  shape: text
  class: note
  near: bottom-center
}

preflight.label.near: center-center
refusal.label.near: center-center

