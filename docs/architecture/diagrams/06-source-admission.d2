  top: 0
  left: 1300
  width: 350
  height: 600
  label.near: top-center
  style.font-size: 18
  style.fill: "#f7f9fc"
  style.stroke: "#9cacc2"
  grant: Signed exact grant\nNew protected issue gate required {
    top: 80
    left: 30
    width: 290
    height: 90
    class: policy
  }
  consume: Fresh guard / full re-projection\nOriginal issuer consumes once {
    top: 270
    left: 30
    width: 290
    height: 90
