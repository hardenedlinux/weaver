direction: right
scheme: Scheme {
 contract: Policy\nTask scope
}
control: Go {
 route: Propose\nRoute + scope
}
execution: Rust {
 reserve: Reserve\nClaim + budget
 consume: Consume\nDurable unknown
 gate: Final gate\nPolicy + fence
 send: Send range\nOne opportunity
 observe: Observe\nKeep unknown holds
}
scheme.contract -> control.route
control.route -> execution.reserve
execution.reserve -> execution.consume -> execution.gate -> execution.send -> execution.observe

