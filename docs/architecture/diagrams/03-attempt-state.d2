...@../../../dev/d2/themes/state
# One original attempt. Visual groups do not add protocol states.
direction: right
title: ATTEMPT LIFECYCLE / ONE-WAY EXECUTION AUTHORITY {
  class: title
  near: top-center
}
before: PREPARATION {
  direction: down
  style.fill: "#F1EAF8"
  style.stroke: "#B8A5CF"
  proposed: Proposed { class: ledger; shape: oval }
  prepared: Prepared\nBudget hold / pending flow { class: ledger }
  pending: ConsumePending\nPersist exact command { class: policy }
  consumed: GrantConsumed\nTransient positive owner knowledge { class: policy; style.stroke-dash: 5 }
}
execution: EXECUTION {
  direction: down
  style.fill: "#EEEAF9"
  style.stroke: "#A697C8"
  committed: SendCommitted\nAdmission linearization { class: ledger }
  claimed: DispatchClaimed\nOriginal claim stays spent { class: runtime }
}
outcome: OBSERVATION AND RECOVERY {
  direction: down
  style.fill: "#F7F4FA"
  style.stroke: "#C4B8D1"
  unknown: OutcomeUnknown\nRetain uncertain exposure { class: unknown }
  no_submit: NoSubmissionProven\nSpent claim retained { class: verified }
  reconcile: Fresh scoped recovery\nInspect / admit evidence / settle { class: semantic }
  recorded: ResultRecorded\nOutcome evidence only { class: verified; shape: page }
}
aborted: AbortedNoDispatch\nIrreversible tombstone {
  class: deny
  shape: oval
  style.double-border: true
}
before.proposed -> before.prepared: Prepare
before.prepared -> before.pending: Reserve / persist / deliver once
before.pending -> before.consumed: Positive consume reply
before.consumed -> execution.committed: Valid S4 CAS
execution.committed -> execution.claimed: Unique S5 claim
execution.claimed -> outcome.recorded: Outcome evidence
execution.claimed -> outcome.unknown: Uncertain submission
execution.claimed -> outcome.no_submit: No-submission proof
before.prepared -> aborted: Deny / error / cancel\nAbort CAS wins
before.pending -> aborted: Reject / timeout / cancel\nAbort CAS wins
before.consumed -> aborted: S4 cannot qualify\nAbort CAS wins
execution.committed -> aborted: Claim absent / abort CAS wins
outcome.unknown -> outcome.reconcile: Fresh recovery
outcome.no_submit -> outcome.reconcile: Fresh cleanup
outcome.reconcile -> outcome.recorded: Admit evidence / no resend
rule: "No result branch returns to dispatch. Emitter closure and accounting remain independent records.\nMissing durable replies are unresolved commands; ResultRecorded does not mean global completion." {
  class: note
  shape: text
  near: bottom-center
}
