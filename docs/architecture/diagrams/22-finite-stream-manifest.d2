semantic.message -> semantic.policy
semantic.policy -> ledger.manifest: complete admitted unit
semantic.adapter -> ledger.recovery: same-operation resolve
ledger.manifest -> owner.admission: immutable descriptor
ledger.account -> owner.admission: current account guards
ledger.recovery -> owner.record: retain obligations
owner.admission -> owner.record
owner.record -> driver.capability: bounded delegation
driver.capability -> driver.frontier
driver.frontier -> driver.exposure
driver.exposure -> owner.quarantine: ambiguous outcome
quint -> owner.quarantine: explore failures {
  style.stroke-dash: 5
}
lean -> driver.frontier: preserve affine ownership {
  style.stroke-dash: 5
}
