}
meaning.message -> owner.records: authenticated binding
meaning.accounts -> owner.shared: stable semantic IDs
meaning.workers -> owner.active: lifecycle proposals
owner.active -> owner.sealed
owner.sealed -> owner.transfer
owner.transfer -> owner.target
owner.shared -> owner.transfer: shared-state witness
owner.records -> broker.context
broker.context -> broker.claim
broker.claim -> broker.offer
quint -> owner.sealed: explore failures {
  style.stroke-dash: 5
}
lean -> owner.shared: preserve invariants {
  style.stroke-dash: 5
}

