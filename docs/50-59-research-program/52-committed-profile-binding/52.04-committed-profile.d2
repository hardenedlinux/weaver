...@../../../dev/d2/themes/flow
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / COMMITTED PROFILE / ORIGINAL NODE {
  class: title
  near: top-center
}
authoring: SCHEME / SEMANTIC AUTHORITY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Scheme + JSON / YAML\nShared value Contracts and decoding\nBounded authoring / strict fields {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Publish the complete profile closure\nUnique nodes / response Contract\nCapabilities / context / region {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Project the assigned original node\nConstruct refinement from its fields\nNo external template substitution {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }

}
semantic: GOVERNANCE / DECIDING STATE {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Cedar Code as Policy / authentic facts\nOriginal key -> profile and node\nPayload / budget / history binding {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: Immutable publication and binding\nResolve exact outcomes after restart\nConflicting replacement rejected {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Preserve original execution identity\nUnknown outcomes retain reservation\nReconcile without creating a claim {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
cloud: GO / CLOUD NATIVE CONTROL {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Publish one typed descriptor closure\nKubernetes lifecycle and discovery\nNew defaults do not repin old work {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Resolve admitted provider facts\nSubmit canonical proposals only\nNo caller-selected task identity {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Reobserve the original binding\nRejoin the current owner fence\nNo authority from a cached read {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
execution: RUST / FINAL EFFECT OWNER {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Queue the bound semantic operation\nJoin current source and profile\nConsume once under the current fence {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: One governed provider attempt\nPreserve node capabilities and scope\nFence the actual transport path {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Validate the original response schema\nGovern bounded result release\nRecord usage under the original account {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nPublication / original binding / stale reads / recovery\nReplacement / rollback / forgotten consumption {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nUnique node resolution / immutable records / recovery\nCommitted constraints -> actual route and semantic use {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
authoring.mcp -> semantic.origin
authoring.a2a -> semantic.origin
authoring.acp -> cloud.fence
authoring.mcp -> cloud.projection
semantic.origin -> execution.cas
execution.hold -> semantic.query: Terminal / usage { style.stroke-dash: 4 }
cloud.projection -> cloud.join
cloud.join -> cloud.fence
cloud.fence -> execution.cas
semantic.alias -> execution.alias: Current decision
execution.cas -> execution.alias
execution.alias -> execution.hold
semantic.origin -> execution.hold: Release decision { style.stroke-dash: 4 }

