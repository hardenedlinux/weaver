source.contract -> source.closure
source.closure -> source.image
source.image -> lifecycle.checks
lifecycle.checks -> lifecycle.return
lifecycle.return -> lifecycle.exit
lifecycle.exit -> authority.evidence
authority.go -> authority.broker: Canonical proposal
authority.evidence -> authority.broker { style.stroke-dash: 4 }

lifecycle.checks -> authority.evidence { style.stroke-dash: 4 }

