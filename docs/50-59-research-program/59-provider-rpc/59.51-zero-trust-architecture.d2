...@../../../dev/d2/themes/system
vars: { d2-config: { layout-engine: tala; pad: 70 } }
title: ZERO TRUST / CONTINUOUS RESOURCE PROTECTION {
  shape: text
  near: top-center
  style.font-size: 34
  style.bold: true
}
identity: Identity and fact authorities\nSubject / workload / delegation\nResource / posture / source cuts {
  class: card
  left: 0
  top: 0
  width: 510
  height: 210
  style.fill: "#eef3ef"
}
scheme: Scheme semantic governance\nAA Session / Workflow / Governor\nRetained parent and evidence contract {
  class: card
  left: 750
  top: 0
  width: 510
  height: 210
  style.fill: "#eef3ef"
}
spec: SPEC functional frameworks\nZero Trust / Usage Control\nCedar Authorization / Delta / POO {
  class: card
  left: 1500
  top: 0
  width: 510
  height: 210
  style.fill: "#eef3ef"
}
go: Go cloud and protocol integration\nWorkload identity / Kubernetes\ngRPC control and administration {
  class: card
  left: 0
  top: 470
  width: 510
  height: 210
  style.fill: "#e7edf4"
}
decision: Rust authoritative decision\nCurrent facts / Cedar assessment\nBound review and publication CAS {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 750
  top: 470
  width: 510
  height: 210
  style.fill: "#e7edf4"
}
execution: Rust final execution owner\nFresh admission after waits\nClaims / conserved holds / final mediation {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 1500
  top: 470
  width: 510
  height: 210
  style.fill: "#e7edf4"
}
observations: Protected local observations\nDecision / outcome / security events\nGoverned feedback and revocation {
  class: card
  left: 0
  top: 940
  width: 510
  height: 210
  style.fill: "#f4f2ec"
}
recovery: Durable recovery and closure\nOriginal claim / budget / history\nUnknown exposure remains held {
  class: card
  left: 750
  top: 940
  width: 510
  height: 210
  style.fill: "#f4f2ec"
}
resource: Protected application effects\nLLM invocation / stream / tool\nResource-specific rights and limits {
  class: card
  left: 1500
  top: 940
  width: 510
  height: 210
  style.fill: "#f4f2ec"
}
identity -> go: Attested context { style.font-size: 18 }
scheme -> decision: Semantic requirements { style.font-size: 18 }
spec -> decision: Functional contracts { style.font-size: 18 }
go -> decision: Authenticated proposals { style.font-size: 18 }
decision -> execution: Current authoritative contract { style.font-size: 18 }
execution -> resource: Guarded effect admission { style.font-size: 18 }
execution -> recovery: Persist exposure { style.font-size: 18 }
recovery -> observations: Bound outcomes { style.font-size: 18 }
observations -> go: Governed feedback { style.font-size: 18 }
footer: "Identity is not authority · Recovery is not reauthorization\nEvery new effect retains the original semantic and consumption contract" {
  shape: text
  left: 250
  top: 1330
  width: 1500
  height: 100
  style.font-size: 26
  style.font-color: "#5c8b77"
}

