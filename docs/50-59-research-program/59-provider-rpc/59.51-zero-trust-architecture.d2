identity -> go: Attested context { style.font-size: 18 }
scheme -> decision: Semantic requirements { style.font-size: 18 }
spec -> decision: Functional contracts { style.font-size: 18 }
go -> decision: Authenticated proposals { style.font-size: 18 }
decision -> execution: Current authoritative contract { style.font-size: 18 }
execution -> resource: Guarded effect admission { style.font-size: 18 }
execution -> recovery: Persist exposure { style.font-size: 18 }
recovery -> observations: Bound outcomes { style.font-size: 18 }
observations -> go: Governed feedback { style.font-size: 18 }
footer: "Identity is not authority · Recovery is not reauthorization\nEvery new effect retains the original semantic and consumption contract" {
  shape: text
  left: 250
  top: 1330
  width: 1500
  height: 100
  style.font-size: 26
  style.font-color: "#5c8b77"
}

