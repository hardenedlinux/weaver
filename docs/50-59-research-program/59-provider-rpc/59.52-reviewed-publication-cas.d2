...@../../../dev/d2/themes/flow
vars: { d2-config: { layout-engine: tala;  pad: 70 } }
title: REVIEWED PUBLICATION / CURRENT AUTHORITY {
  shape: text
  near: top-center
  style.font-size: 34
  style.bold: true
}
parent: Independent parent authority\nExact source / Contract / profile\nRetain required parent Sessions {
  class: card
  left: 0
  top: 0
  width: 510
  height: 220
  style.fill: "#eef3ef"
}
review: Approved Delta evidence\nExact parent / candidate / schema\nBound analysis and replay artifact {
  class: card
  left: 750
  top: 0
  width: 510
  height: 220
  style.fill: "#eef3ef"
}
pending: Original pending intent\nImmutable command and review binding\nUnknown reply preserves the barrier {
  class: card
  left: 1500
  top: 0
  width: 510
  height: 220
  style.fill: "#f4f2ec"
}
binding: LeanPoo evidence-bound Contract\nPreserve original invocation rule\nMatch independent deciding references {
  class: card
  left: 0
  top: 470
  width: 510
  height: 220
  style.fill: "#e7edf4"
}
cas: Rust authoritative publication CAS\nCurrent parent / artifact / cut / fence\nCommit phase performs no external send {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 750
  top: 470
  width: 510
  height: 220
  style.fill: "#e7edf4"
}
outcome: Durable original outcome\nCommitted or rejected / exact identity\nResolve only the original pending key {
  class: card
  left: 1500
  top: 470
  width: 510
  height: 220
  style.fill: "#e7edf4"
}
use: Rust final execution owner\nFresh authorization at actual use\nPreserve consumption and unknown holds {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 750
  top: 970
  width: 510
  height: 220
  style.fill: "#eef3ef"
}
recovery: Exact recovery and observation\nRetain outcome / review / pending\nHistorical success is not current authority {
  class: card
  left: 1500
  top: 970
  width: 510
  height: 220
  style.fill: "#f4f2ec"
}
parent -> binding: Authoritative reference { style.font-size: 18 }
review -> binding: Approved evidence { style.font-size: 18 }
binding -> cas: Bound original contract { style.font-size: 18 }
pending -> cas: Exact final join { style.font-size: 18 }
cas -> outcome: Atomic decision { style.font-size: 18 }
cas -> use: Current publication { style.font-size: 18 }
outcome -> recovery: Lost reply / restart { style.font-size: 18 }
footer: "Evidence is not an execution permit · Publication is not a provider send\nStale or unresolved authority cannot erase the original claim, budget or history" {
  shape: text
  left: 200
  top: 1370
  width: 1650
  height: 100
  style.font-size: 26
  style.font-color: "#5c8b77"
}

