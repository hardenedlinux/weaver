vars: { d2-config: { layout-engine: tala;  pad: 70 } }
title: FUNCTIONAL FRAMEWORKS / POO / FINAL EXECUTION {
  shape: text
  near: top-center
  style.font-size: 32
  style.bold: true
}
zero: Zero Trust framework\nTyped requirement functions\nContinuity / attributes / revocation\nGeneric POO profiles and refinement {
  class: card
  left: 0
  top: 0
  width: 490
  height: 240
  style.fill: "#e7edf4"
}
authorization: Authorization framework\nCedar Policy combination\nSchema-bound execution Delta\nSource and proof evidence {
  class: card
  left: 1400
  top: 0
  width: 490
  height: 240
  style.fill: "#e7edf4"
}
gateway: Gateway POO specialization\nOriginal publication and Contract\nCurrent assessment / consumed prefix\nStrengthen both framework contracts {
  class: card
  left: 700
  top: 450
  width: 490
  height: 240
  style.fill: "#eef3ef"
}
ingress: Scheme Session / Governor\nGo cloud and protocol ingress\nHigher-order continuation proposals\nCanonical identity and typed gRPC {
  class: card
  icon: ../../architecture/diagrams/assets/go.svg
  icon.near: top-left
  left: 0
  top: 900
  width: 490
  height: 240
  style.fill: "#eef3ef"
}
rust: Rust final execution owner\nDurable original consumption\nFresh guard after every wait\nEvery row / original range / owner {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 700
  top: 900
  width: 490
  height: 240
  style.fill: "#e7edf4"
}
transport: Guarded queue / transport\nOne-use execution capability\nAdmitted buffers may drain\nReceipt remains an observation {
  class: card
  left: 1400
  top: 900
  width: 490
  height: 240
  style.fill: "#f4f2ec"
}
unknown: Uncertain outcome\nKeep original claim and hold\nPreserve consumed prefix / frontier\nReconcile without replay or refund {
  class: card
  left: 700
  top: 1370
  width: 490
  height: 220
  style.fill: "#f4f2ec"
}
zero -> gateway: Functional specialization { style.font-size: 18 }
authorization -> gateway: Bound Cedar assessment { style.font-size: 18 }
gateway -> rust: Execution contract { style.font-size: 18 }
ingress -> rust: Authenticated proposal { style.font-size: 18 }
rust -> transport: Current final admission { style.font-size: 18 }
rust -> unknown: Interrupt / revoke / lost commit {
  style.font-size: 18
  style.stroke-dash: 5
}
footer: "Frameworks are reusable · Gateway consumes them\nFresh assessment preserves the original commitment" {
  shape: text
  left: 340
  top: 1740
  width: 1280
  height: 100
  style.font-size: 24
  style.font-color: "#5c8b77"
}

