...@../../../dev/d2/themes/flow
vars: {d2-config: {layout-engine: tala;  pad: 70}}
classes: {card: {label.near: center-center; style.font-size: 21; style.border-radius: 12}}
title: ORIGINAL GOVERNANCE CAPTURE / INERT SOURCE HANDOFF {shape: text; near: top-center; style.font-size: 32; style.bold: true}
profile: Original AA Profile and context\nIdentity / model / native threats\nOriginal source and Policy inputs\nCaller-owned data can be mutable {
  class: card; left: 0; top: 0; width: 500; height: 220; style.fill: "#eef3ef"
}
capture: Scheme program / scoped capture\nOne producer / sealed methods\nPrivate source before callbacks\nClose fences late callback results {
  class: card; left: 720; top: 0; width: 500; height: 220; style.fill: "#f4f2ec"
}
assessment: AA assessment / source guard\nOriginal blocking threats refuse\nFinal guards after all callbacks\nOne completed source emission {
  class: card; left: 1440; top: 0; width: 500; height: 220; style.fill: "#eef3ef"
}
native: Rust / Scheme typed boundary\nFixed SDK exports / strong roots\nOwned result / compare original\nNo object words across queues {
  class: card; left: 1440; top: 320; width: 500; height: 220; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
host: Rust compiled program owner\nInstalled application and catalog\nCurrent source before / after capture\nTracked VM / natural shutdown {
  class: card; left: 720; top: 320; width: 500; height: 220; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
send: Rust final executor\nFresh Cedar / current Policy and fence\nOriginal claim / history / shared hold\nUnknown sends cannot redispatch {
  class: card; left: 720; top: 640; width: 500; height: 220; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
commit: Rust authority transaction\nOriginal pending intent and outcome\nCurrent source / parent / task origin\nPublication never sends {
  class: card; left: 0; top: 640; width: 500; height: 220; style.fill: "#e7edf4"
}
control: Go source control and routing\nApproved producer / owned task\nFrozen proposal / ordered routes\nOriginal stream / typed gRPC {
  class: card; left: 0; top: 320; width: 500; height: 220; style.fill: "#eef3ef"
  icon: ../../architecture/diagrams/assets/go.svg; icon.near: top-left
}
profile -> capture: Capture before callback {style.font-size: 18}
catalog: Configured original producer catalog\nFrozen artifact / source binding\nEligibility requires actual source auth\nNo grant from fingerprint labels {
  class: card; left: 1440; top: 640; width: 500; height: 220; style.fill: "#eef3ef"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
catalog -> native: Retained original {style.font-size: 18}
capture -> assessment: Frozen input {style.font-size: 18}
assessment -> native: Typed objects / no file bridge {style.font-size: 18}
native -> host: Rust-owned bound data {style.font-size: 18}
host -> control: Typed source over gRPC {style.font-size: 18}
control -> commit: Frozen source gRPC {style.font-size: 18}
commit -> send: Original intent {style.font-size: 18}
footer: "Bounded Policy inputs · Original capture · Assessment never grants execution" {
  shape: text; left: 100; top: 1040; width: 1750; height: 70; style.font-size: 24; style.font-color: "#5c8b77"
}

