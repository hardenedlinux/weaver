# Core design only. Versions, benchmark results and acceptance evidence belong in Org.
vars: {
  d2-config: {
    layout-engine: tala
    pad: 60
  }
}
classes: {
  card: {
    label.near: center-center
    style.font-size: 18
    style.border-radius: 8
    style.stroke-width: 1
  }
}
title: WEAVER / DEFAULT gRPC GATEWAY {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}
source: Scheme / Yuanxu modules\nGovernance Policy / source assets\nBound source → Cedar FFI {
  class: card
  left: 0
  top: 0
  width: 380
  height: 110
}
source_rpc: Source mTLS gRPC\nAtomic task / profile registration\nBounded publish / recovery lane {
  class: card
  left: 480
  top: 0
  width: 380
  height: 110
}
telemetry: Telemetry Service\nDefault local Go / Rust events\nPolicy-controlled export {
  class: card
  left: 960
  top: 0
  width: 380
  height: 110
  style.fill: "#edf4f0"
  style.stroke: "#5c8b77"
}
assurance: Project SysML · Cedar · Quint · Lean {
  shape: text
  left: 0
  top: 660
  width: 1340
  height: 60
  style.font-size: 22
  style.font-color: "#5c8b77"
}
control: Go Control Plane\nSource-bound LLM routing\nDeadline-bound transport setup {
  class: card
  icon: ../../architecture/diagrams/assets/go.svg
  icon.near: top-left
  left: 0
  top: 220
  width: 380
  height: 110
}
rpc: Operation mTLS gRPC\nPinned caller and method role {
  class: card
  left: 480
  top: 220
  width: 380
  height: 110
}
owner: Rust Deciding Owner\nRegistry / claim / budget CAS\nFresh Cedar dispatch and release {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 960
  top: 220
  width: 380
  height: 110
}
consumer: Go Stream Consumer\nOrdered data and canonical receipt {
  class: card
  left: 0
  top: 440
  width: 380
  height: 110
}
release: Original Plan / Encoding Token\nFresh Cedar Release Guard\nProtobuf or optional Arrow IPC {
  class: card
  left: 480
  top: 440
  width: 380
  height: 110
}
provider: LLM Provider / SSE\nOne consumed HTTPS invocation {
  class: card
  left: 960
  top: 440
  width: 380
  height: 110
}
source -> control: Governed config
control -> source_rpc: Observe / initial CAS
source_rpc -> owner: Policy / outcome CAS
control -> rpc: Typed RPC
rpc -> owner: Admit
owner -> provider: Cedar + cancellation
owner -> telemetry: Bounded events {
  style.stroke-dash: 4
}
provider -> release: SSE
release -> consumer: Stream

