...@../../../dev/d2/themes/flow
vars: { d2-config: { layout-engine: tala;  pad: 80 } }
title: MRR ADMISSION / RUST FINAL USE {
  shape: text
  near: top-center
  style.font-size: 36
  style.bold: true
}
semantic: Weaver canonical coordination home\nOriginal claim / shared budget scope\nImmutable obligation body {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 0
  top: 0
  width: 550
  height: 240
  style.fill: "#eef3ef"
}
storage: MRR Data backend\nTurso embedded storage\nPure validation / authority checks {
  class: card
  left: 810
  top: 0
  width: 550
  height: 240
  style.fill: "#e7edf4"
}
retained: Retained admission outcome\nExact operation / content commitment\nBurn and original unknown obligation {
  class: card
  left: 1620
  top: 0
  width: 550
  height: 240
  style.fill: "#e7edf4"
}
pending: Missing body or uncertain outcome\nKeep original reservation and exposure\nNo new home or inferred refund {
  class: card
  left: 0
  top: 620
  width: 550
  height: 240
  style.fill: "#f4f2ec"
}
projection: Read body / qualify current cut\nOriginal owner and exposure projection\nReplay grants no live send ticket {
  class: card
  left: 810
  top: 620
  width: 550
  height: 240
  style.fill: "#e7edf4"
}
execution: Rust final transport owner\nLive one-use ticket / current Policy\nSingle release / no replay authority {
  class: card
  icon: ../../architecture/diagrams/assets/rust.svg
  icon.near: top-left
  left: 1620
  top: 620
  width: 550
  height: 240
  style.fill: "#eef3ef"
}
semantic -> storage: Publish durable body first { style.font-size: 20 }
storage -> retained: Metadata decision and outbox { style.font-size: 20 }
storage -> projection: Recover exact original outcome { style.font-size: 20 }
pending -> projection: Recover original obligation { style.font-size: 20 }
projection -> execution: Fresh final-use guards { style.font-size: 20 }
retained -> execution: Recheck current cut { style.font-size: 20 }
footer: "Scheme owns workflow semantics · Go owns protocol admission · Rust owns final release\nA historical storage decision cannot authorize a new effect" {
  shape: text
  left: 140
  top: 1080
  width: 1890
  height: 120
  style.font-size: 28
  style.font-color: "#5c8b77"
}

