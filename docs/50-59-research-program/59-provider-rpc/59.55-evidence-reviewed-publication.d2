...@../../../dev/d2/themes/flow
vars: {d2-config: {layout-engine: tala;  pad: 70}}
classes: {card: {label.near: center-center; style.font-size: 21; style.border-radius: 12}}
title: ORIGINAL REVIEW / ONE DECIDING AUTHORITY {shape: text; near: top-center; style.font-size: 32; style.bold: true}
source: Scheme Governance / AA\nOriginal semantic contracts\nCedar and upstream review evidence\nInert preparation {
  class: card; left: 0; top: 0; width: 470; height: 210; style.fill: "#eef3ef"
}
host: Trusted review host\nAuthenticate evidence producer\nValidate actual semantic approval\nBind original command and parent {
  class: card; left: 690; top: 0; width: 470; height: 210; style.fill: "#f4f2ec"
}
pending: Rust deciding store\nLatch mandatory review\nCapture actual Policy / schema parent\nRetain original pending intent {
  class: card; left: 1380; top: 0; width: 480; height: 210; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
evidence: Immutable review registration\nExact command and captured parent\nFull upstream artifact retained\nReply loss changes no binding {
  class: card; left: 0; top: 490; width: 470; height: 210; style.fill: "#f4f2ec"
}
cas: Rust final publication CAS\nJoin review and actual parent\nOne transaction / original outcome\nResolve only this pending key {
  class: card; left: 690; top: 490; width: 470; height: 210; style.fill: "#e7edf4"
}
execution: Rust final execution\nCurrent Cedar and committed task\nClaim / budget / history / fence\nUnknown exposure remains held {
  class: card; left: 1380; top: 490; width: 480; height: 210; style.fill: "#eef3ef"
}
source -> host: Evidence requirements {style.font-size: 18}
host -> pending: Stage exact proposal {style.font-size: 18}
host -> evidence: Qualified host admission {style.font-size: 18}
evidence -> cas: Exact retained review {style.font-size: 18}
pending -> cas: Original parent and intent {style.font-size: 18}
cas -> execution: Committed origin {style.font-size: 18}
footer: "Registration is not publication · Publication never sends · Historical success is not current authority" {
  shape: text; left: 50; top: 870; width: 1760; height: 60; style.font-size: 23; style.font-color: "#5c8b77"
}

# Project-owned presentation question; not an issued governance Question.
