...@../../../dev/d2/themes/flow
vars: {d2-config: {layout-engine: elk; pad: 50}}
direction: right
classes: {card: {width: 360; height: 160; label.near: center-center; style.font-size: 20; style.border-radius: 12}}
spec: Scheme build.ss\nPackageSpec dependency declaration {class: card}
profile: Existing host profile\npkg-config library resolution {class: card}
scheme: std/make\nDeclared Scheme compiler options {class: card}
receipt: Atomic package link receipt\nStandard Cargo directives {class: card}
adapter: Rust package build adapter\nTyped validation / bounded read {class: card; icon: ../../architecture/diagrams/assets/rust.svg; icon.near: outside-top-center}
cargo_linker: Cargo-managed linking\nDeclared libraries and search inputs {class: card}
spec -> profile: pkg-config-libs
profile -> scheme: options resolver
profile -> receipt: resolved package inputs
receipt -> adapter: completed receipt
adapter -> cargo_linker: CargoDirective

vars: {d2-config: {data: {figure: |json
{
  "title": "Package-managed Scheme and Rust linkage",
  "purpose": "workflow",
  "kind": "flow",
  "language": "en",
  "width": 960,
  "primary": "main",
  "questions": [
    {
      "ref": "main",
      "text": "How do declared Scheme dependencies reach Rust package linking?",
