  "references": {
    "catalog": "docs/architecture/08-diagram-catalog.org",
    "model": "Project.sysml"
  },
  "copy": {
    "takeaway": "The package declares its libraries; native package mechanisms own discovery and linking."
  },
  "basis": {
    "captureRef": "docs/50-59-research-program/59-provider-rpc/59.75-package-linkage.d2#design-view",
