...@../../../dev/d2/themes/flow
vars: {d2-config: {layout-engine: elk; pad: 50}}
direction: down
classes: {card: {style.font-size: 20; style.border-radius: 12; width: 420; height: 100}}
title: DEVELOPMENT COMPILER OWNER / TERMINAL DRAIN {shape: text; style.font-size: 28}
input: Declared source capture\nOriginal model / source identity {class: card}
owner: Owned compiler queue\nAccepted work / bounded lifetime {class: card}
artifact: Bound SVG and topology\nComplete node and edge coverage {class: card}
closing: Closing fence\nReject new work / drain accepted work {class: card}
exit: Natural child exit\nOne shared terminal result {class: card}
failed: Observed child failure\nPreserve failure / closed IPC {class: card; style.fill: "#f8e9e7"}
input -> owner: Capture original inputs
owner -> artifact: Complete compilation
artifact -> closing: Close
closing -> exit: Observe actual exit
owner -> failed: Early exit or error
failed -> closing: Keep failure
footer: Compilation observations confer no publication or send authority {shape: text; style.font-size: 20}

vars: {d2-config: {data: {figure: |json
{
  "title": "Development compiler ownership and drain",
  "purpose": "workflow",
  "kind": "flow",
  "language": "en",
  "width": 960,
  "primary": "main",
  "questions": [
    {
      "ref": "main",
