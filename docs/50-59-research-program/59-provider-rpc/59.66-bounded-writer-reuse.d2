...@../../../dev/d2/themes/flow
vars: { d2-config: { layout-engine: tala;  pad: 80 } }
title: PRIVATE WRITER REUSE / FRESH AUTHORIZATION {
  shape: text
  near: top-center
  style.font-size: 36
  style.bold: true
}
