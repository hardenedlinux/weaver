...@../../../dev/d2/themes/data
vars: {d2-config: {layout-engine: tala;  pad: 70}}
classes: {card: {label.near: center-center; style.font-size: 21; style.border-radius: 12}}
title: SOURCE KEY CUSTODY / FINAL TRANSACTION ADMISSION {shape: text; near: top-center; style.font-size: 32; style.bold: true}
author: Scheme Governor / Policy\nRust SDK typed source capture\nOriginal task / exact commitments\nCompilation grants no execution {
  class: card; left: 0; top: 0; width: 480; height: 220; style.fill: "#eef3ef"
}
control: Go source control\nExplicit handoff / exact reconciliation\nControlled credential rollout\nNo implicit rebase or key reuse {
  class: card; left: 700; top: 0; width: 500; height: 220; style.fill: "#eef3ef"
  icon: ../../architecture/diagrams/assets/go.svg; icon.near: top-left
}
host: Rust authenticated RPC host\nActual TLS leaf / SPKI / credential\nSeparate source and operation roles\nStartup pins are a prefilter {
  class: card; left: 1420; top: 0; width: 500; height: 220; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
custody: Persistent source custody\nCurrent binding / retained key prefix\nOriginal command and outcome\nUnknown reply preserves commitment {
  class: card; left: 0; top: 500; width: 480; height: 220; style.fill: "#f4f2ec"
}
decision: Rust deciding transaction\nFirst enrollment: every app table empty\nRecheck actual source at mutation\nAtomic handoff or publication\nHistorical receipt grants no permit {
  class: card; left: 700; top: 500; width: 500; height: 220; style.fill: "#e7edf4"
}
send: Rust final executor\nCurrent Cedar / original task / fence\nClaim and shared budget retained\nUnknown sends cannot redispatch {
  class: card; left: 1420; top: 500; width: 500; height: 220; style.fill: "#eef3ef"
}
author -> control: Typed source over gRPC {style.font-size: 18}
control -> host: Authenticated source RPC {style.font-size: 18}
host -> decision: Actual principal {style.font-size: 18}
custody -> decision: Current deciding state {style.font-size: 18}
decision -> send: Original authority {style.font-size: 18}
footer: "Retired keys stay fenced · Handoff never refunds unknown exposure · Local custody requires independent recovery protection" {
  shape: text; left: 30; top: 890; width: 1890; height: 70; style.font-size: 24; style.font-color: "#5c8b77"
}
