vars: {d2-config: {layout-engine: tala; theme-id: 3; pad: 70}}
classes: {card: {label.near: center-center; style.font-size: 21; style.border-radius: 12}}
title: ORIGINAL GOVERNANCE CAPTURE / INERT SOURCE HANDOFF {shape: text; near: top-center; style.font-size: 32; style.bold: true}
profile: Original AA Profile and context\nIdentity / model / native threats\nOriginal source and Policy inputs\nCaller-owned data can be mutable {
  class: card; left: 0; top: 0; width: 500; height: 220; style.fill: "#eef3ef"
}
capture: Scheme canonical capture\nPrivate original data snapshots\nNative Record contracts\nSelected local method references {
  class: card; left: 720; top: 0; width: 500; height: 220; style.fill: "#f4f2ec"
}
assessment: AA assessment / Scheme guard\nOriginal blocking threats refuse\nRecheck data and context after call\nLive aliases cannot replace capture {
  class: card; left: 1440; top: 0; width: 500; height: 220; style.fill: "#eef3ef"
}
send: Rust final executor\nFresh Cedar / current Policy and fence\nOriginal claim / history / shared hold\nUnknown sends cannot redispatch {
  class: card; left: 0; top: 510; width: 500; height: 220; style.fill: "#e7edf4"
  icon: ../../architecture/diagrams/assets/rust.svg; icon.near: top-left
}
commit: Rust authority transaction\nOriginal pending intent and outcome\nCurrent source / parent / task origin\nPublication never sends {
  class: card; left: 720; top: 510; width: 500; height: 220; style.fill: "#e7edf4"
}
control: Go source control and routing\nTyped source / exact reconciliation\nNo activation from unknown outcomes\nNo provider execution capability {
  class: card; left: 1440; top: 510; width: 500; height: 220; style.fill: "#eef3ef"
  icon: ../../architecture/diagrams/assets/go.svg; icon.near: top-left
}
profile -> capture: Capture before callback {style.font-size: 18}
capture -> assessment: Independent original image {style.font-size: 18}
assessment -> control: Admitted source data {style.font-size: 18}
control -> commit: Authenticated source RPC {style.font-size: 18}
commit -> send: Committed original intent {style.font-size: 18}
footer: "Agreeing live aliases cannot replace original capture · Assessment never grants execution" {
  shape: text; left: 100; top: 900; width: 1750; height: 70; style.font-size: 24; style.font-color: "#5c8b77"
}
