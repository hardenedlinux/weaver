...@../../../dev/d2/themes/flow
# Core design only; source identities and proof receipts remain in Org.
title: WEAVER / ONE TASK / ONE GOVERNED EXECUTION {
  class: title
  near: top-center
}
authoring: SCHEME / SEMANTIC AUTHORITY {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  mcp: Scheme + JSON / YAML\nOne POO Type / Contracts projection\nBounded source evaluation {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  a2a: Original task and knowledge snapshot\nPinned profile / ordered messages\nRetrieve -> infer -> release {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  acp: Construct node refinement\nIntersect targets / retain requirements\nClamp budget / preserve history {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }

}
semantic: GOVERNANCE / DECIDING STATE {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  origin: Cedar Code as Policy / authentic facts\nRead / invoke / release actions\nCurrent original claim and profile {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  alias: One logical deciding transaction\nReservation / fence / execution key\nAtomic outcome recovery {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  query: Unknown execution retains budget\nTerminal evidence before settlement\nOriginal application ID applied once {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
}
cloud: GO / CLOUD NATIVE CONTROL {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  projection: Publish admitted semantic package\nKubernetes and discovery lifecycle\nResolve original outcomes on retry {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  join: Protocol and provider proposals\nCapability / tokenizer / price facts\nNo hidden SDK network effects {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  fence: Canonical binding and observations\nNo new family on reconnect\nNo new grant from telemetry {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
execution: RUST / FINAL EFFECT OWNER {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  cas: Persist queue without sending\nJoin current claim / Policy / history\nConsume the original execution key {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  alias: One admitted provider attempt\nBound wire / credential / destination\nFence every bounded write {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Bounded provider stream buffer\nValidate complete typed result\nGovern release and reconcile usage {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nQueue / consume / hard changes / restart interleavings\nUnknown holds / late usage / forbidden retries {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nConstruct original-task-to-node refinement\nActual route / semantic use / source claim composition {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
authoring.mcp -> semantic.origin
authoring.a2a -> semantic.origin
authoring.acp -> cloud.fence
authoring.mcp -> cloud.projection
semantic.origin -> execution.cas
execution.hold -> semantic.query: Terminal / usage { style.stroke-dash: 4 }
cloud.projection -> cloud.join
cloud.join -> cloud.fence
cloud.fence -> execution.cas
semantic.alias -> execution.alias: Current decision
execution.cas -> execution.alias
execution.alias -> execution.hold
semantic.origin -> execution.hold: Release decision { style.stroke-dash: 4 }

