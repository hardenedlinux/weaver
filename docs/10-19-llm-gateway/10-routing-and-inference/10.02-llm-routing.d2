...@../../../dev/d2/themes/routing
# Candidate discovery is advisory. Exactly one selected target receives the request.
direction: down
title: LLM ROUTING / ORIGINAL INTENT TO ONE PROVIDER {
  class: title
  near: top-center
}
control: ORIGINAL INTENT AND CONSTRAINTS {
  class: [semantic; column]
  direction: down
  style.fill: "#FFF7EA"
  style.stroke: "#CDBA95"
  intent: Scheme / original task\nMessages / tools / model intent\nCanonical root / response contract { class: semantic }
  catalog: Go / model discovery\nKubernetes pools / workload identity\nCapabilities / prices / soft metrics { class: cloud }
  policy: Scheme / Cedar contracts\nRegion / history / shared budget\nCurrent source publication { class: policy }
}
candidates: AVAILABLE DEPLOYMENT METADATA {
  class: [cloud; column]
  direction: down
  style.fill: "#F0F5FB"
  style.stroke: "#B2C3D8"
  hosted: Hosted deployments\nApproved provider / region { class: cloud }
  private: Private inference pools\nKubernetes / self-hosted models { class: cloud }
  specialist: Specialist deployments\nDeclared capability / output contract { class: cloud }
}
router: RUST / BOUND ROUTE DECISION {
  class: runtime
  direction: right
  style.fill: "#FFF2DC"
  style.stroke: "#D1AD75"
  normalize: Resolve requested model / alias\nRetain original request provenance { class: runtime }
  choose: Filter eligible models, then rank\nQuality / cost / latency / priority\nAdvisory ranking stays constrained { shape: hexagon; class: policy }
  plan: Freeze selected RoutePlan\nModel / endpoint / wire manifest\nOriginal allowance / current Policy { shape: page; class: ledger }
}
broker: RUST / FINAL EXECUTION {
  class: runtime
  direction: right
  style.fill: "#F1EEF8"
  style.stroke: "#B7A8CC"
  encode: Encode exact provider request\nProtocol / tools / owned buffers\nBound credentials / wire manifest { class: runtime }
  send: Recheck at actual invocation\nCurrent route / Policy / original claim\nNo hidden retry or route mutation { shape: hexagon; class: runtime }
  selected: One selected provider\nOriginal target / exact request { class: cloud }
  stream: One response source\nNormalized stream / backpressure\nUnknown usage retains the hold { class: unknown }
}
deny: No permitted route\nNo consume / no send { class: deny }
control.intent -> router.normalize
control.catalog -> router.choose: Discovery proposal { style.stroke-dash: 4 }
control.policy -> router.choose: Semantic constraints { style.stroke-dash: 4 }
candidates -> router.choose: Candidate facts only { style.stroke-dash: 4 }
router.normalize -> router.choose
router.choose -> router.plan: One eligible selection
router.choose -> deny: None permitted
router.plan -> broker.encode: Exact selected plan
broker.encode -> broker.send
broker.send -> broker.selected: One admitted invocation
broker.selected -> broker.stream: Bound response
proof: "Quint: wrong target / stale route / unknown retry / mixed response sources.\nLean: target eligibility / current-route preservation / original escrow and response-source binding.\nAfter consumption, fallback and reconnect cannot create a replacement attempt or refund unknown usage." {
  class: note
  shape: text
  near: bottom-center
}
