# Core design only; source identities and proof receipts remain in Org.
...@../../architecture/diagrams/lib/theme
title: WEAVER / AUTHORITY READS / FINAL CONSUMPTION CAS {
  class: title
  near: top-center
}
reads: SCHEME AND GO / SOURCE CONTEXT {
  top: 0
  left: 0
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  binding: Original semantic binding\nClaim / profile / account domains\nScheme contract / Go observations {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  image: Separate authoritative reads\nPublication / execution / Policy\nAuthentic reads can still be stale {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: cloud
  }
  prepare: Prepared recovery request\nIssued permit / complete expected cut\nRead success is not consumption {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  goBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/go.svg
    top: 247
    left: 24
    width: 42
    height: 22
  }
  kubernetesBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/kubernetes.svg
    top: 247
    left: 82
    width: 28
    height: 28
  }
}
owner: RUST / SERIALIZATION AUTHORITY {
  top: 0
  left: 440
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  generation: Effective Policy and history\nPublish every change to owner cut\nNo Allow / Deny / Allow reuse {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  fence: Current logical owner fence\nRestart and revocation retire permits\nNo independent effective update gap {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  cas: Final conditional consumption\nExact cut / actual Policy / fresh ID\nOne serialized durable mutation {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
result: RUST / DURABLE DECISION {
  top: 0
  left: 880
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f7faf9"
  style.stroke: "#9bb6ad"
  decision: Exact original decision log\nRequest / actual cut / consumed slot\nCommit precedes acknowledgement {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  confirm: Attributable late confirmation\nQuery the same committed decision\nNo activation or new consumption {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  recovery: Qualified prefix recovery\nUnknown result is not absence\nOld worker cannot reopen the slot {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
}
broker: RUST / FINAL EXECUTION OWNER {
  top: 0
  left: 1320
  width: 350
  height: 690
  label.near: top-center
  style.font-size: 17
  style.fill: "#f8fafb"
  style.stroke: "#9bb6ad"
  consume: Original operation and send gate\nOriginal claim / child / wire scope\nNew request cannot reset spent-state {
    top: 90
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: runtime
  }
  policy: Original contract still applies\nProfile / history / budget / response\nNo scope expansion by Go adapter {
    top: 295
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: policy
  }
  hold: Original usage and settlement\nUnknown usage retains the hold\nLate receipt cannot refund or resend {
    top: 500
    left: 20
    width: 310
    height: 120
    label.near: center-center
    class: semantic
  }
  rustBrand: "" {
    shape: image
    icon: ../../architecture/diagrams/assets/rust.svg
    top: 40
    left: 156
    width: 34
    height: 34
  }
}
quint: QUINT\nTorn reads / Policy ABA / stale fences\nLost replies / duplicate decisions / late ack {
  top: 810
  left: 220
  width: 610
  height: 100
  class: policy
}
lean: LEAN\nExact accepted cut / original source steps\nUnique decisions / preserved obligations {
  top: 810
  left: 960
  width: 610
  height: 100
  class: semantic
}
reads.binding -> reads.image
reads.image -> reads.prepare
reads.prepare -> owner.cas
owner.generation -> owner.fence { style.stroke-dash: 4 }
owner.fence -> owner.cas
owner.cas -> result.decision
result.decision -> result.confirm
result.confirm -> result.recovery
result.decision -> broker.consume
broker.policy -> broker.consume { style.stroke-dash: 4 }
broker.policy -> broker.hold
