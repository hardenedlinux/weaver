593: func modelFailoverBackend(ctx RouteContext, model *agentgateway.AgentgatewayModel, parent RouteParentReference) (*api.Backend, error) {
594: 	groups := map[int32][]*api.AIBackend_Provider{}
595: 	var errs []error
596: 	for _, target := range model.Spec.VirtualModel.Failover.Targets {
597: 		_, provider, err := translateFailoverTarget(ctx, model.Namespace, target)
598: 		if err != nil {
599: 			errs = append(errs, err)
600: 			continue
601: 		}
602: 		groups[target.Priority] = append(groups[target.Priority], provider)
603: 	}
604: 	if len(groups) == 0 {
605: 		err := errors.Join(errs...)
606: 		if err == nil {
607: 			err = fmt.Errorf("failover requires at least one valid target")
608: 		}
609: 		return nil, err
610: 	}
611: 
612: 	priorities := make([]int32, 0, len(groups))
613: 	for p := range groups {
614: 		priorities = append(priorities, p)
615: 	}
616: 	slices.Sort(priorities)
617: 
618: 	backend := &api.AIBackend{}
619: 	for _, priority := range priorities {
620: 		providers := groups[priority]
621: 		slices.SortFunc(providers, func(a, b *api.AIBackend_Provider) int {
622: 			return strings.Compare(a.GetName(), b.GetName())
623: 		})
624: 		backend.ProviderGroups = append(backend.ProviderGroups, &api.AIBackend_ProviderGroup{Providers: providers})
625: 	}
626: 
627: 	return &api.Backend{
628: 		Key:  modelBackendKey(model, parent, "failover"),
629: 		Name: plugins.ResourceName(model),
630: 		Kind: &api.Backend_Ai{Ai: backend},
631: 	}, errors.Join(errs...)
632: }
