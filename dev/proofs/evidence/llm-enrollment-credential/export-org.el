(require 'org)
(require 'ox-html)
(setq org-confirm-babel-evaluate nil)
(let ((org-export-use-babel nil)
      (org-export-with-broken-links nil)
      (files (append (list (expand-file-name "README.org"))
                     (directory-files-recursively (expand-file-name "docs") "\\.org\\'")
                     (directory-files-recursively (expand-file-name "specs") "\\.org\\'"))))
  (dolist (file files)
    (with-current-buffer (find-file-noselect file)
      (org-export-to-file 'html (concat "/private/tmp/weaver-check-" (file-name-base file) ".html"))))
  (message "PASS: exported %d Org documents without evaluating source blocks" (length files)))
