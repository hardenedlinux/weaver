module LlmWalActivation {
  import LlmAccountCommit as A from "./LlmAccountCommit"
  type Receipt = { head: A::Image, journal: List[A::Record], epoch: int, sourceGeneration: int }
  pure val zero = Rec("head", A::genesis, "journal", List(), "epoch", 0, "sourceGeneration", 0)
  pure def frame = ((p) => Rec("proposal", p, "after", A::post(field(p, "before"), field(p, "transaction")), "epoch", field(p, "worker")))
  def view = Rec("head", field(A::a, "anchor"), "journal", field(A::a, "journal"), "epoch", field(A::a, "epoch"), "sourceGeneration", field(A::a, "sourceGeneration"))
  type Wal = { records: List[A::Record], candidates: Set[A::Record], receipt: Receipt, haveReceipt: bool, active: bool, sourceQualified: bool }
  pure val initial = Rec("records", List(), "candidates", Set(), "receipt", zero, "haveReceipt", true, "active", true, "sourceQualified", true)
  pure val f0 = frame(A::p0)
  var w: Wal
  def current = and(field(w, "haveReceipt"), eq(field(w, "receipt"), view))
  def complete = and(igte(length(field(w, "records")), length(field(A::a, "journal"))), forall(indices(field(A::a, "journal")), ((i) => eq(nth(field(w, "records"), i), nth(field(A::a, "journal"), i)))))
  action init = actionAll(A::init, assign(w, initial))
  action prepared = actionAll(A::prepared, assign(w, initial))
  action flush = ((p, durable) => actionAll(contains(field(A::a, "prepared"), p), A::gate(p), eq(field(w, "records"), field(A::a, "journal")), durable, A::loseReply, assign(w, with(w, "records", append(field(w, "records"), frame(p))))))
  action submit = ((p, durable) => actionAll(exists(indices(field(w, "records")), ((i) => eq(nth(field(w, "records"), i), frame(p)))), contains(field(A::a, "prepared"), p), A::gate(p), durable, A::loseReply, assign(w, with(with(w, "candidates", union(field(w, "candidates"), Set(frame(p)))), "active", false))))
  action anchor = ((p, policy, durable) => actionAll(contains(field(w, "candidates"), frame(p)), A::commit(p, policy, durable), assign(w, with(w, "active", false))))
  action rotate = actionAll(A::rotate, assign(w, with(w, "active", false)))
  action conflict = actionAll(A::conflictUsage, assign(w, with(with(w, "active", false), "sourceQualified", false)))
  action restoreWal = ((records) => actionAll(A::loseReply, assign(w, with(with(w, "records", records), "active", false))))
  action repair = ((authentic) => actionAll(authentic, A::loseReply, assign(w, with(with(w, "records", field(A::a, "journal")), "active", false))))
  action observe = ((authentic) => actionAll(authentic, A::loseReply, assign(w, with(with(w, "receipt", view), "haveReceipt", true))))
  action restoreImage = ((image) => actionAll(A::restore(image), assign(w, with(w, "active", false))))
  action prepareNext = ((p) => actionAll(field(w, "active"), A::prepare(p), assign(w, w)))
  action loseReply = actionAll(A::loseReply, assign(w, with(with(w, "haveReceipt", false), "active", false)))
  action lateFull = actionAll(A::lateFull, assign(w, w))
  val candidateSound = forall(field(w, "candidates"), ((r) => eq(field(r, "after"), A::post(field(field(r, "proposal"), "before"), field(field(r, "proposal"), "transaction")))))
  val anchoredOnly = forall(indices(field(A::a, "journal")), ((i) => contains(field(w, "candidates"), nth(field(A::a, "journal"), i))))
  action unsafeCandidateConfirmation = actionAll(A::loseReply, assign(w, with(with(with(w, "receipt", Rec("head", field(f0, "after"), "journal", List(f0), "epoch", field(A::a, "epoch"), "sourceGeneration", field(A::a, "sourceGeneration"))), "haveReceipt", true), "active", true)))
  action unsafeRequalifyActivate = actionAll(A::unsafeRecover, assign(w, with(w, "active", true)))
  action unsafeActivate = actionAll(A::loseReply, assign(w, with(w, "active", true)))
  action unsafeWalCredit = actionAll(A::unsafeApply(A::p0), assign(w, w))
  action unsafeDropAnchor = actionAll(A::unsafeRollback, assign(w, w))
  action unsafeRetry = actionAll(A::unsafeApply(A::p0), assign(w, with(w, "active", false)))
  action install = actionAll(current, complete, not(field(A::a, "qualified")), A::restore(field(A::a, "anchor")), assign(w, with(w, "active", false)))
  action activate = ((authentic) => actionAll(current, complete, authentic, field(w, "sourceQualified"), eq(field(A::a, "local"), field(A::a, "anchor")), ite(field(A::a, "qualified"), A::loseReply, A::recover(true)), assign(w, with(w, "active", true))))
  action flushed = then(prepared, flush(A::p0, true))
  val live = implies(field(w, "active"), and(and(and(and(field(w, "sourceQualified"), field(A::a, "qualified")), eq(field(A::a, "local"), field(A::a, "anchor"))), current), complete))
  action submitted = then(flushed, submit(A::p0, true))
  val safety = and(and(and(anchoredOnly, A::safety), live), candidateSound)
  action step = nondet p = oneOf(union(field(A::a, "prepared"), Set(A::p0, A::p1))) { actionAny(prepareNext(p), flush(p, true), submit(p, true), anchor(p, true, true), rotate, conflict, restoreWal(List()), repair(true), observe(true), install, restoreImage(A::genesis), restoreImage(field(A::a, "anchor")), activate(true), loseReply, lateFull) }
  action anchored = then(submitted, anchor(A::p0, true, true))
  action replayed = then(then(then(anchored, observe(true)), repair(true)), install)
  action truncated = then(anchored, restoreWal(List()))
  action activated = then(replayed, activate(true))
}
