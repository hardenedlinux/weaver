module LlmSourceCustody {
  import LlmSourceJoin as J from "./LlmSourceJoin"
  import LlmAdmissionFloor.Proposal from "./LlmAdmissionFloor"
  import LlmAdmissionFloor.Record from "./LlmAdmissionFloor"
  import LlmAdmissionFloor.f from "./LlmAdmissionFloor"
  import LlmAdmissionFloor.pAppend from "./LlmAdmissionFloor"
  import LlmAdmissionFloor.pEarlyCut from "./LlmAdmissionFloor"
  import LlmAdmissionFloor.seed from "./LlmAdmissionFloor"
  type Custody = { phase: int, fence: int, holder: int, original: Proposal, attempt: Proposal, haveIntent: bool, outcome: Record, haveOutcome: bool, resolved: bool, lastChecked: bool }
  pure val initial = Rec("phase", 0, "fence", 0, "holder", 0, "original", pAppend, "attempt", pAppend, "haveIntent", false, "outcome", seed, "haveOutcome", false, "resolved", true, "lastChecked", true)
  action idle = actionAll(J::idle, assign(J::j, J::j))
  var custody: Custody
  def current = ((holder, fence) => and(eq(holder, field(custody, "holder")), eq(fence, field(custody, "fence"))))
  val safety = and(and(and(and(J::safety, field(custody, "lastChecked")), or(eq(field(custody, "phase"), 0), field(custody, "haveIntent"))), or(not(field(custody, "haveOutcome")), and(exists(indices(field(f, "log")), ((i) => eq(nth(field(f, "log"), i), field(custody, "outcome")))), eq(field(field(field(custody, "outcome"), "proposal"), "id"), field(field(custody, "original"), "id"))))), or(neq(field(custody, "phase"), 4), field(custody, "haveOutcome")))
  action init = actionAll(J::appendInit, assign(custody, initial))
  action begin = ((p) => actionAll(eq(field(custody, "phase"), 0), idle, assign(custody, with(with(with(with(custody, "phase", 1), "original", p), "attempt", p), "haveIntent", true))))
  action validate = actionAll(eq(field(custody, "phase"), 1), field(custody, "resolved"), J::validate(field(custody, "attempt"), true), assign(custody, custody))
  action propose = actionAll(eq(field(custody, "phase"), 1), J::propose(field(custody, "attempt")), assign(custody, custody))
  action transfer = ((holder, durable) => actionAll(igt(field(custody, "phase"), 0), ilt(field(custody, "phase"), 4), durable, J::restart, assign(custody, with(with(with(with(custody, "fence", iadd(field(custody, "fence"), 1)), "holder", holder), "phase", ite(field(custody, "haveOutcome"), 3, 1)), "resolved", false))))
  action restart = actionAll(J::restart, assign(custody, with(custody, "resolved", false)))
  action sourceChange = actionAll(neq(field(custody, "phase"), 2), J::sourceChange(true), assign(custody, custody))
  action unsafeClose = actionAll(idle, assign(custody, with(with(custody, "phase", 4), "lastChecked", and(and(eq(field(custody, "phase"), 3), field(custody, "haveOutcome")), field(custody, "resolved")))))
  action unsafeDrop = actionAll(J::restart, assign(custody, with(with(custody, "haveIntent", false), "haveOutcome", false)))
  action unsafeWrongResult = actionAll(idle, assign(custody, with(with(custody, "outcome", Rec("proposal", pEarlyCut)), "haveOutcome", true)))
  action unsafeSourceChange = actionAll(J::sourceChange(true), assign(custody, with(custody, "lastChecked", neq(field(custody, "phase"), 2))))
  action unsafeRestoreFence = actionAll(idle, assign(custody, with(with(custody, "fence", 0), "lastChecked", false)))
  action arm = ((holder, fence, durable) => actionAll(eq(field(custody, "phase"), 1), field(custody, "resolved"), current(holder, fence), durable, J::joined(field(custody, "attempt")), field(J::j, "allows"), idle, assign(custody, with(with(custody, "phase", 2), "resolved", false))))
  action publish = ((holder, fence) => actionAll(eq(field(custody, "phase"), 2), current(holder, fence), not(field(custody, "haveOutcome")), J::publishAppend(field(custody, "attempt")), assign(custody, with(with(with(with(custody, "phase", 3), "outcome", Rec("proposal", field(custody, "attempt"))), "haveOutcome", true), "resolved", false))))
  action resolve = ((holder, fence, authentic) => actionAll(current(holder, fence), authentic, idle, assign(custody, with(custody, "resolved", true))))
  action close = ((holder, fence) => actionAll(eq(field(custody, "phase"), 3), field(custody, "haveOutcome"), field(custody, "resolved"), current(holder, fence), idle, assign(custody, with(custody, "phase", 4))))
  action unsafeOldPublish = actionAll(J::publishAppend(field(custody, "attempt")), assign(custody, with(with(with(with(custody, "phase", 3), "outcome", Rec("proposal", field(custody, "attempt"))), "haveOutcome", true), "lastChecked", current(0, 0))))
  action armed = then(then(then(then(init, begin(pAppend)), propose), validate), arm(0, 0, true))
  action step = actionAny(begin(pAppend), propose, validate, arm(field(custody, "holder"), field(custody, "fence"), true), publish(field(custody, "holder"), field(custody, "fence")), transfer(isub(1, field(custody, "holder")), true), resolve(field(custody, "holder"), field(custody, "fence"), true), restart, sourceChange, close(field(custody, "holder"), field(custody, "fence")))
  run unprotectedArmRejectedTest = then(then(then(then(init, begin(pAppend)), propose), validate), fail(arm(0, 0, false)))
  action handed = then(armed, transfer(1, true))
  action committed = then(armed, publish(0, 0))
  action restarted = then(armed, restart)
  run unprotectedTransferRejectedTest = then(armed, fail(transfer(1, false)))
  run armedMutationBlockedTest = then(armed, fail(sourceChange))
  run armedMutationCustodyCounterexampleTest = expect(then(armed, unsafeSourceChange), not(safety))
  action recovered = then(then(then(handed, resolve(1, 1, true)), validate), arm(1, 1, true))
  action transferredCommit = then(committed, transfer(1, true))
  run exactCustodyPublishesTest = expect(committed, safety)
  run transferRequiresResolutionTest = then(handed, fail(validate))
  run oldCustodyCannotResolveTest = then(handed, fail(resolve(0, 0, true)))
  run unresolvedResultCannotCloseTest = then(committed, fail(close(0, 0)))
  run unknownResultCannotCloseTest = then(restarted, fail(close(0, 0)))
  run restartRequiresTransferBeforeRearmTest = then(restarted, fail(arm(0, 0, true)))
  run forgedRecoveryRejectedTest = then(handed, fail(resolve(1, 1, false)))
  run unknownCloseCustodyCounterexampleTest = expect(then(restarted, unsafeClose), not(safety))
  run unresolvedCloseCustodyCounterexampleTest = expect(then(committed, unsafeClose), not(safety))
  run droppedIntentCustodyCounterexampleTest = expect(then(handed, unsafeDrop), not(safety))
  run wrongResultCustodyCounterexampleTest = expect(then(handed, unsafeWrongResult), not(safety))
  run rolledBackFenceCustodyCounterexampleTest = expect(then(handed, unsafeRestoreFence), not(safety))
  action resolvedCommit = then(transferredCommit, resolve(1, 1, true))
  run recoveredHolderPublishesTest = expect(then(recovered, publish(1, 1)), safety)
  run oldCustodyCannotPublishTest = then(recovered, fail(publish(0, 0)))
  run oldPermitCustodyCounterexampleTest = expect(then(recovered, unsafeOldPublish), not(safety))
  action closed = then(resolvedCommit, close(1, 1))
  run lostCommitResolvedAfterTransferTest = expect(resolvedCommit, and(safety, eq(field(field(custody, "outcome"), "proposal"), pAppend)))
  run knownResultCannotPublishAgainTest = then(resolvedCommit, fail(publish(1, 1)))
  run closeOnlyCustodyTest = expect(closed, and(safety, eq(length(field(f, "log")), 2)))
  run closedRestartRetainsOutcomeTest = expect(then(closed, restart), and(and(safety, field(custody, "haveOutcome")), not(field(custody, "resolved"))))
}
