  action newJoined = then(then(newCommit, applySource(d1, 0)), applyAccount(d1, 0))
  action dequeued = then(enqueued, dequeue(op0, 0))
  action rangeReady = then(then(then(then(dequeued, fenceLane), certify(true)), prepareRange), activateRange(true))
  action observed = then(rangeReady, observeOffer(0))
  action burned = then(observed, burn(t0, 0, true, true))
  action switched = then(then(then(observed, restart), recover(true)), activate)
  action offered = then(burned, submit(t0, 0, true, true))
  action realigned = then(then(then(then(then(then(switched, recoverExecution(true)), alignOwner(1)), certify(true)), prepareRange), activateRange(true)), observeOffer(1))
  action partialWrite = then(offered, partial(t0, 2))
}
