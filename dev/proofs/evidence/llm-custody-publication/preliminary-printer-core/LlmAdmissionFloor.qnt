module LlmAdmissionFloor {
  import LlmAppendHandoff as H from "./LlmAppendHandoff"
  pure def capture = ((h, worker) => Rec("root", field(h, "root"), "closed", field(h, "closed"), "live", field(h, "live"), "allocated", field(h, "allocated"), "rootGeneration", field(h, "rootGeneration"), "appendGeneration", field(h, "appendGeneration"), "frontier", field(h, "frontier"), "sequence", field(h, "sequence"), "cut", field(h, "cut"), "haveCut", field(h, "haveCut"), "candidate", field(h, "candidate"), "haveCandidate", field(h, "haveCandidate"), "worker", worker, "sourceGeneration", 0))
  type Image = { root: H::Manifest, closed: List[H::Segment], live: List[H::Segment], allocated: Set[H::Segment], rootGeneration: int, appendGeneration: int, frontier: int, sequence: int, cut: H::Cut, haveCut: bool, candidate: H::Manifest, haveCandidate: bool, worker: int, sourceGeneration: int }
  pure val i0 = capture(H::initial, 0)
  def image = capture(H::h, field(H::view, "worker"))
  action idle = actionAll(H::idle, assign(H::h, H::h))
  pure def appendedImage = ((i) => with(with(with(i, "live", append(field(i, "live"), H::tailSegment)), "allocated", union(field(i, "allocated"), Set(H::tailSegment))), "frontier", iadd(field(i, "frontier"), 1)))
  pure def cutImage = ((i) => with(with(with(with(with(with(i, "closed", concat(field(i, "closed"), field(i, "live"))), "live", List()), "appendGeneration", iadd(field(i, "appendGeneration"), 1)), "sequence", iadd(field(i, "sequence"), 1)), "haveCut", true), "cut", Rec("id", iadd(field(i, "sequence"), 1), "parent", field(field(i, "root"), "id"), "rootGeneration", field(i, "rootGeneration"), "appendGeneration", iadd(field(i, "appendGeneration"), 1), "records", concat(concat(H::manifestReplay(field(i, "root")), H::flat(field(i, "closed"))), H::flat(field(i, "live"))))))
  type Proposal = { id: int, intent: int, parent: int, before: Image, after: Image, worker: int }
  pure val seed = Rec("proposal", Rec("id", 0, "intent", 0, "parent", 0, "before", i0, "after", i0, "worker", 0))
  pure val pAppend = Rec("id", 1, "intent", 12, "parent", 1, "before", i0, "after", appendedImage(i0), "worker", 0)
  type Record = { proposal: Proposal }
  pure val initial = Rec("log", List(seed), "pending", Set(), "local", i0, "haveLocal", false, "objects", Set(), "bodies", Set(), "observed", Rec("revision", 1, "record", seed), "haveReceipt", false, "active", false, "resolved", seed, "haveResolved", false, "attemptedWorker", 0)
  pure val i1 = field(pAppend, "after")
  type Receipt = { revision: int, record: Record }
  pure val pCut = Rec("id", 2, "intent", 20, "parent", 2, "before", i1, "after", cutImage(i1), "worker", 0)
  type Floor = { log: List[Record], pending: Set[Proposal], local: Image, haveLocal: bool, objects: Set[H::Segment], bodies: Set[H::Manifest], observed: Receipt, haveReceipt: bool, active: bool, resolved: Record, haveResolved: bool, attemptedWorker: int }
  pure val i2 = field(pCut, "after")
  pure val pEarlyCut = with(with(with(pCut, "parent", 1), "before", i0), "after", cutImage(i0))
  var f: Floor
  pure val pFence = Rec("id", 3, "intent", 90, "parent", 3, "before", i2, "after", with(i2, "worker", 1), "worker", 0)
  def current = Rec("revision", length(field(f, "log")), "record", nth(field(f, "log"), isub(length(field(f, "log")), 1)))
  def complete = and(and(forall(indices(H::refs), ((i) => contains(field(f, "objects"), nth(H::refs, i)))), exists(field(f, "bodies"), ((m) => eq(field(m, "checkpoint"), field(field(H::h, "root"), "checkpoint"))))), or(not(field(H::h, "haveCandidate")), exists(field(f, "bodies"), ((m) => eq(field(m, "checkpoint"), field(field(H::h, "candidate"), "checkpoint"))))))
  val floorAligned = eq(field(field(nth(field(f, "log"), isub(length(field(f, "log")), 1)), "proposal"), "after"), image)
  val unique = forall(indices(field(f, "log")), ((i) => forall(indices(field(f, "log")), ((j) => or(neq(field(field(nth(field(f, "log"), i), "proposal"), "id"), field(field(nth(field(f, "log"), j), "proposal"), "id")), eq(nth(field(f, "log"), i), nth(field(f, "log"), j)))))))
  val chain = forall(indices(field(f, "log")), ((i) => and(and(eq(field(field(nth(field(f, "log"), i), "proposal"), "parent"), i), eq(field(field(nth(field(f, "log"), i), "proposal"), "worker"), field(field(field(nth(field(f, "log"), i), "proposal"), "before"), "worker"))), or(eq(i, 0), eq(field(field(nth(field(f, "log"), i), "proposal"), "before"), field(field(nth(field(f, "log"), isub(i, 1)), "proposal"), "after"))))))
  action init = actionAll(H::prepared, assign(f, initial))
  action propose = ((p, durable) => actionAll(durable, forall(field(f, "pending"), ((old) => or(neq(field(old, "id"), field(p, "id")), eq(field(old, "intent"), field(p, "intent"))))), idle, assign(f, with(with(f, "pending", union(field(f, "pending"), Set(p))), "active", false))))
  pure val pOldFence = Rec("id", 4, "intent", 90, "parent", 4, "before", field(pFence, "after"), "after", with(field(pFence, "after"), "worker", 2), "worker", 0)
  action restore = ((snapshot, objects, bodies) => actionAll(idle, assign(f, with(with(with(with(with(with(f, "local", snapshot), "haveLocal", true), "objects", objects), "bodies", bodies), "haveReceipt", false), "active", false))))
  action loseReply = actionAll(idle, assign(f, with(with(f, "haveReceipt", false), "active", false)))
  action installCopies = ((authentic) => actionAll(authentic, idle, assign(f, with(with(with(f, "objects", map(indices(H::refs), ((i) => nth(H::refs, i)))), "bodies", Set(field(H::h, "root"), field(H::h, "candidate"))), "active", false))))
  action submit = actionAll(H::submit, assign(f, with(f, "active", false)))
  action financialCommit = actionAll(H::commit, assign(f, with(f, "active", false)))
  action unsafeActivate = ((worker) => actionAll(idle, assign(f, with(with(f, "active", true), "attemptedWorker", worker))))
  action unsafeUseResult = actionAll(field(f, "haveResolved"), idle, assign(f, with(with(with(f, "observed", Rec("revision", iadd(field(field(field(f, "resolved"), "proposal"), "parent"), 1), "record", field(f, "resolved"))), "haveReceipt", true), "active", true)))
  action unsafeRollbackLog = actionAll(idle, assign(f, with(f, "log", List(seed))))
  action unsafeDuplicate = actionAll(idle, assign(f, with(f, "log", append(field(f, "log"), Rec("proposal", with(pAppend, "after", with(field(pAppend, "after"), "appendGeneration", 1)))))))
  def confirmed = and(field(f, "haveReceipt"), eq(field(f, "observed"), current))
  action query = ((worker, authentic) => actionAll(authentic, eq(worker, field(H::view, "worker")), H::observe(worker, true), assign(f, with(with(with(f, "observed", current), "haveReceipt", true), "active", false))))
  action resolve = ((id) => nondet r = oneOf(filter(map(indices(field(f, "log")), ((i) => nth(field(f, "log"), i))), ((r) => eq(field(field(r, "proposal"), "id"), id)))) { actionAll(idle, assign(f, with(with(with(f, "resolved", r), "haveResolved", true), "active", false))) })
  action unsafeOldFence = actionAll(H::rotate, assign(f, with(with(with(with(f, "log", append(field(f, "log"), Rec("proposal", pOldFence))), "haveReceipt", false), "active", false), "attemptedWorker", 0)))
  def qualified = and(and(and(confirmed, field(f, "haveLocal")), eq(field(f, "local"), image)), complete)
  action project = ((worker, authentic) => actionAll(confirmed, complete, authentic, eq(worker, field(H::view, "worker")), idle, assign(f, with(with(with(f, "local", image), "haveLocal", true), "active", false))))
  val safety = and(and(and(and(floorAligned, chain), unique), implies(field(f, "active"), and(qualified, eq(field(f, "attemptedWorker"), field(H::view, "worker"))))), H::safety)
  def gate = ((p) => and(and(and(and(and(qualified, contains(field(f, "pending"), p)), eq(field(p, "parent"), length(field(f, "log")))), eq(field(p, "before"), image)), eq(field(p, "worker"), field(H::view, "worker"))), forall(indices(field(f, "log")), ((i) => neq(field(field(nth(field(f, "log"), i), "proposal"), "id"), field(p, "id"))))))
  action activate = ((worker) => actionAll(qualified, eq(worker, field(H::view, "worker")), idle, assign(f, with(with(f, "active", true), "attemptedWorker", worker))))
  action commitAppend = ((p, bodyDurable, durable, policy) => actionAll(gate(p), eq(field(p, "intent"), 12), eq(field(p, "after"), appendedImage(image)), bodyDurable, durable, policy, H::appendFrame(field(p, "worker"), field(field(p, "before"), "appendGeneration"), field(field(p, "before"), "frontier"), true, true), assign(f, with(with(with(f, "log", append(field(f, "log"), Rec("proposal", p))), "haveReceipt", false), "active", false))))
  action commitCut = ((p, bodyDurable, durable, policy) => actionAll(gate(p), eq(field(p, "intent"), 20), eq(field(p, "after"), cutImage(image)), bodyDurable, durable, policy, H::sealCut(field(p, "worker"), field(field(p, "before"), "appendGeneration"), field(field(p, "before"), "frontier"), true, true), assign(f, with(with(with(f, "log", append(field(f, "log"), Rec("proposal", p))), "haveReceipt", false), "active", false))))
  action commitFence = ((p, bodyDurable, durable, policy) => actionAll(gate(p), eq(field(p, "intent"), 90), eq(field(p, "after"), with(image, "worker", iadd(field(H::view, "worker"), 1))), bodyDurable, durable, policy, H::rotate, assign(f, with(with(with(f, "log", append(field(f, "log"), Rec("proposal", p))), "haveReceipt", false), "active", false))))
  action qualifiedInit = then(then(then(then(init, query(0, true)), installCopies(true)), project(0, true)), activate(0))
  action proposed = then(qualifiedInit, propose(pAppend, true))
  action step = nondet p = oneOf(Set(pAppend, pCut, pEarlyCut, pFence)) { nondet snapshot = oneOf(Set(i0, i1, i2, image)) { actionAny(propose(p, true), commitAppend(p, true, true, true), commitCut(p, true, true, true), commitFence(p, true, true, true), query(field(H::view, "worker"), true), resolve(field(p, "id")), restore(snapshot, Set(), Set()), restore(snapshot, field(f, "objects"), field(f, "bodies")), installCopies(true), project(field(H::view, "worker"), true), activate(field(H::view, "worker")), loseReply, submit, financialCommit) } }
  action published = then(proposed, commitAppend(pAppend, true, true, true))
  action recovered = then(then(then(then(published, query(0, true)), installCopies(true)), project(0, true)), activate(0))
  action pending = then(recovered, submit)
  action sealed = then(then(pending, propose(pCut, true)), commitCut(pCut, true, true, true))
  action sealedRecovered = then(then(then(then(sealed, query(0, true)), installCopies(true)), project(0, true)), activate(0))
  action rotated = then(then(sealedRecovered, propose(pFence, true)), commitFence(pFence, true, true, true))
  action lateCommitted = then(sealedRecovered, financialCommit)
  action rolledBack = then(rotated, restore(i0, Set(H::old), Set(H::root0)))
  action ownerRecovered = then(then(then(then(rolledBack, query(1, true)), installCopies(true)), project(1, true)), activate(1))
}
