P31 a74fc2fd63437252175b5a67649ee54b886d3bf4:packages/proofs/quint/SessionAttempt.qnt SHA256 2857ad1bc556179f034255a93537a136f08dcc21cd46458a6af18fef206f58b4
10:   var routed: List[(int,int)]
11:   var recoveries: List[(int,int)]
12:   action init = all { generation' = 0, active' = -1, pending' = -1,
13:     closed' = false, everClosed' = false, routed' = List(), recoveries' = List() }
14:   action claim = all {
15:     not(closed), active == -1, pending == -1, generation < 3,
16:     generation' = generation + 1, active' = generation + 1,
17:     pending' = pending, closed' = closed, everClosed' = everClosed, routed' = routed, recoveries' = recoveries
18:   }
19:   action complete(requestGeneration: int): bool = all {
22:     routed' = routed.append((requestGeneration,active)), active' = -1,
23:     generation' = generation, pending' = pending, closed' = closed, everClosed' = everClosed, recoveries' = recoveries
24:   }
25:   action recover = all {
26:     (not(closed) or BUG == "resumeClosed"), generation < 3, recoveries.length() < 2,
27:     generation' = generation + 1, active' = -1, closed' = false, everClosed' = everClosed,
28:     pending' = if (BUG == "dropObligation") -1 else if (active >= 0) active else pending,
29:     recoveries' = recoveries.append((if (active >= 0) active else pending,
30:       if (BUG == "dropObligation") -1 else if (active >= 0) active else pending)),
31:     routed' = routed
32:   }
33:   action reconcile = all {
34:     pending >= 0, pending' = -1, active' = active, generation' = generation,
35:     closed' = closed, everClosed' = everClosed, routed' = routed, recoveries' = recoveries
36:   }
37:   action close = all {
39:     generation' = generation, active' = active, pending' = pending,
40:     routed' = routed, recoveries' = recoveries
41:   }
42:   action step = {
43:     nondet requestGeneration = Set(0,1,2,3).oneOf()
44:     any { claim, complete(requestGeneration), recover, reconcile, close }
45:   }
46:   val ExactAttempt = routed.foldl(true, (ok,r) => ok and r._1 == r._2)
47:   val RecoveryPreservesObligation = recoveries.foldl(true, (ok,r) => ok and (r._1 < 0 or r._1 == r._2))
48:   val ClosedIsTerminal = not(everClosed) or closed
49:   val safety = ExactAttempt and RecoveryPreservesObligation and ClosedIsTerminal
50: }

