101: ;; : (-> PooDurableRuntimeStorePredicate PooDurableRuntimeStoreValueList Bool)
102: (def (poo-flow-durable-runtime-store-every? predicate values)
103:   (cond
104:    ((null? values) #t)
105:    ((predicate (car values))
106:     (poo-flow-durable-runtime-store-every? predicate (cdr values)))
107:    (else #f)))
108: 
109: ;; : (forall (a) (-> a (List a) Bool))
110: (def (poo-flow-durable-runtime-store-member? value values)
111:   (if (member value values) #t #f))
