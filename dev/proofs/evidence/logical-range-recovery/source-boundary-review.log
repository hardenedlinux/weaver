C11 c8d1a0641120cf65e299e8a98f9fe7666ca96ab5:CedarPooSpec/Composition.lean SHA256 3a6bd1ae53c74d9a6eebdcf56964e0f886b91ae82bb1af2c885b76ca15530be1
1: import CedarPooSpec.Evaluation
2: import CedarPooSpec.Validation
3: import LeanPoo.Proof.Product
4: import LeanPoo.Object.Debug
5: 
6: /-!
7: Compose the independent Cedar evaluation and typechecking certificates.
8: Keys remain disjoint, so an evaluation patch leaves typechecking obligations
9: outside its invalidation footprint and conversely.
10: -/
11: 
12: namespace CedarPooSpec.Composition
13: 
14: open LeanPoo.Proof
15: 
16: abbrev Key := Sum Evaluation.Key Validation.Key
17: abbrev Value := SumValue Evaluation.Value Validation.Value
18: 
19: def proofObject (evaluation : Evaluation.Snapshot)
20:     (validation : Validation.Snapshot) : ProofObject Key Value :=
21:   evaluation.proofObject.pair validation.proofObject
22: 
23: theorem certificate (evaluation : Evaluation.Snapshot)
24:     (validation : Validation.Snapshot)
25:     (evaluationValid : evaluation.result =
26:       Cedar.Spec.evaluate evaluation.expr evaluation.request evaluation.entities)
27:     (validationValid : validation.result =
28:       Cedar.Validation.typecheckPolicy validation.policy validation.environment) :
29:     Certificate (proofObject evaluation validation) :=
30:   Certificate.pair evaluation.proofObject validation.proofObject
31:     (evaluation.certificate evaluationValid)
32:     (validation.certificate validationValid)
33: 
34: def replaceExprPatch (evaluation : Evaluation.Snapshot)
35:     (expr : Cedar.Spec.Expr) : Patch Key Value :=
36:   (Evaluation.replaceExprPatch evaluation expr).left
37: 
38: def replacePolicyPatch (validation : Validation.Snapshot)
39:     (policy : Cedar.Spec.Policy) : Patch Key Value :=
40:   (Validation.replacePolicyPatch validation policy).right
41: 
42: /-- The evaluator input is the expression of the policy being checked. -/
43: def alignmentObligation : Obligation Key Value where
44:   dependencies := [.inl .expr, .inr .policy]
45:   holds := fun state =>
46:     state (.inl .expr) = (state (.inr .policy)).toExpr
47:   stable := by
48:     intro before after equal holds
49:     have he : before (.inl .expr) = after (.inl .expr) :=
50:       equal (.inl .expr) (by simp)
51:     have hp : before (.inr .policy) = after (.inr .policy) :=
52:       equal (.inr .policy) (by simp)
53:     simpa [he, hp] using holds
54: 
55: def alignedProofObject (evaluation : Evaluation.Snapshot)
56:     (validation : Validation.Snapshot) : ProofObject Key Value :=
57:   (proofObject evaluation validation).withObligation alignmentObligation
58: 
59: theorem alignedCertificate (evaluation : Evaluation.Snapshot)
60:     (validation : Validation.Snapshot)
61:     (evaluationValid : evaluation.result =
62:       Cedar.Spec.evaluate evaluation.expr evaluation.request evaluation.entities)
63:     (validationValid : validation.result =
64:       Cedar.Validation.typecheckPolicy validation.policy validation.environment)
65:     (aligned : evaluation.expr = validation.policy.toExpr) :
66:     Certificate (alignedProofObject evaluation validation) :=
67:   Certificate.withObligation (proofObject evaluation validation)
68:     (certificate evaluation validation evaluationValid validationValid)
69:     alignmentObligation aligned
