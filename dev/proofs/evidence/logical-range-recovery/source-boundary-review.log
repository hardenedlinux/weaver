72: def AuthorityContextLineagePrefix.toPublicationDomain
73:     (lineagePrefix : AuthorityContextLineagePrefix)
74:     (domainIdentity domainSemanticIdentity : Nat) :
75:     AuthoritativeContextPublicationDomain where
76:   domainIdentity := domainIdentity
77:   domainSemanticIdentity := domainSemanticIdentity
78:   authorityIdentity := lineagePrefix.lineage.authorityIdentity
79:   published := publishedByLineagePrefix lineagePrefix
80:   authorityBound := by
81:     intro context published
82:     rcases published with ⟨position, _, contextEqual⟩
83:     rw [← contextEqual]
84:     exact lineagePrefix.lineage.fixedAuthority position
85:   forkFree := lineagePrefixPublicationIsForkFree lineagePrefix
86: 
87: structure LineagePrefixPublicationDomainBinding
88:     (lineagePrefix : AuthorityContextLineagePrefix)
89:     (domain : AuthoritativeContextPublicationDomain) : Prop where
90:   authorityIdentityBound :
91:     domain.authorityIdentity = lineagePrefix.lineage.authorityIdentity
92:   publishedExact :
