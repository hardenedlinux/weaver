72:     cycleObservationId := watchdog.cycleObservationId
73:     continuationIdentity := watchdog.continuationIdentity
74:     progressReceiptId := "independent-progress-receipt"
75:     semanticConsumed := 1
76:     semanticRemaining := 0
77:     schedulingConsumed := 0
78:     schedulingRemaining := 1
79:     provenanceDigest := "exhausted-budget-provenance" }
