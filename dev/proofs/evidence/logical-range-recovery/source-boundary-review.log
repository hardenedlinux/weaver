32:     generation := watchdog.generation
33:     cycleObservationId := watchdog.cycleObservationId
34:     continuationIdentity := watchdog.continuationIdentity
35:     progressReceiptId := "independent-progress-receipt"
36:     semanticConsumed := 0
37:     semanticRemaining := 1
38:     schedulingConsumed := 0
39:     schedulingRemaining := 1
40:     provenanceDigest := "positive-budget-provenance" }
41: 
