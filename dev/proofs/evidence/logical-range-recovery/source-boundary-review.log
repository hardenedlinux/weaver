45:       watchdog.thresholdValue < watchdog.observedValue) :
46:     watchdog.thresholdValue < watchdog.observedValue ∧
47:       runtimeWatchdogBudgetCoordinatesMatch
48:         watchdog (positiveBudgetReceiptForWatchdog watchdog) ∧
49:       ¬ deterministicBudgetExhausted
