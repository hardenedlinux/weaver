63:   intro left right leftPublished rightPublished sameAuthority sameGeneration
64:   apply lineagePublicationIsForkFree lineagePrefix.lineage
65:   · rcases leftPublished with ⟨position, _, contextEqual⟩
68:     exact ⟨position, contextEqual⟩
69:   · exact sameAuthority
70:   · exact sameGeneration
