615: 
616: 	fn resolve_concrete_model(
617: 		&self,
618: 		requested_model: &str,
619: 		allow_internal: bool,
620: 		req: &Request,
621: 	) -> Result<Option<ResolvedBackend>, ()> {
622: 		// `models` can store things like `provider/*`. The concrete `requested_model` will be like `provider/real-model`.
623: 		let matches = |model: &ModelRoute| {
624: 			(allow_internal || model.visibility == ModelVisibility::Public)
625: 				&& model_name_matches(&model.name, requested_model)
626: 				&& header_matches(&model.header_matches, req)
627: 		};
628: 		let Some(model) = self
629: 			.models
630: 			.iter()
631: 			.find(|model| matches(model) && model_authorized(model, req))
632: 		else {
633: 			return if self.models.iter().any(matches) {
634: 				Err(())
635: 			} else {
636: 				Ok(None)
637: 			};
638: 		};
639: 		Ok(Some(ResolvedBackend {
640: 			backend: model.backend.clone(),
641: 			route_type: classify_route(req.uri().path()).unwrap_or(
642: 				model
643: 					.policies
644: 					.passthrough
645: 					.unwrap_or(llm::RouteType::Passthrough),
646: 			),
647: 			llm_policy: model.policies.llm.clone(),
648: 		}))
649: 	}
650: }
