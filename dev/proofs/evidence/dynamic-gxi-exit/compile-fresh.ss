(import :gerbil/compiler :gerbil/expander)
(def root (getenv "WEAVER_NATIVE_ROOT"))
(def source (path-expand "source/" root))
(def output (getenv "WEAVER_NATIVE_LIB"))
(create-directory* output)
(def original-import (current-expander-module-import))
(def seen (make-hash-table-eq))
(def compiled (make-hash-table))
(def (source-import path (reload? #f))
  (def datum (syntax-e path))
  (def name (and (symbol? datum) (symbol->string datum)))
  (def local (and name
    (or (string-prefix? ":core/" name) (string-prefix? ":clan/poo/" name))
    (path-expand (string-append (substring name 1 (string-length name)) ".ss") source)))
  (when (and local (not (file-exists? local))) (error "missing isolated source" name local))
  (original-import (or local path) reload?))
;; Fresh builds start with an empty compiled set; no previous artifacts are admitted.
(def (visit context)
  (cond
    ((module-import? context) (visit (module-import-source context)))
    ((module-export? context) (visit (module-export-context context)))
    ((import-set? context) (visit (import-set-source context)))
    ((and (prelude-context? context) (not (hash-key? seen context)))
      (hash-put! seen context #t)
      (for-each visit (prelude-context-import context))
      (let* ((identity (expander-context-id context))
             (name (and (symbol? identity) (symbol->string identity)))
             (local (and name (or (string-prefix? "core/" name) (string-prefix? "clan/poo/" name))
                         (path-expand (string-append name ".ss") source))))
        (when (and local (file-exists? local)) (visit (core-import-module local)))))
    ((and (module-context? context) (not (hash-key? seen context)))
      (hash-put! seen context #t)
      (cond ((core-context-prelude context) => visit))
      (for-each visit (module-context-import context))
      (let* ((identity (expander-context-id context))
             (name (and (symbol? identity) (symbol->string identity)))
             (local (and name (or (string-prefix? "core/" name) (string-prefix? "clan/poo/" name) (string-prefix? "weaver-native/" name))
                         (path-expand (string-append name ".ss") source))))
        (when (and local (file-exists? local) (not (hash-key? compiled name)))
          (displayln "COMPILE-START " name) (force-output)
          (compile-module local [output-dir: output invoke-gsc: #t keep-scm: #t])
          (execute-pending-compile-jobs!)
          (hash-put! compiled name #t)
          (displayln "COMPILE-DONE " name) (force-output))))))
(parameterize ((current-expander-context (make-top-context))
               (current-expander-module-import source-import))
  (visit (core-import-module (path-expand "weaver-native/fixture.ss" source))))
(displayln "ISOLATED-SOURCE-BUILD-COMPLETE") (force-output)
