(require 'org)
(require 'ox-html)
(setq org-confirm-babel-evaluate nil)
(let ((org-export-use-babel nil)
      (org-export-with-broken-links nil)
      (files (directory-files-recursively (expand-file-name "docs/40-49-admission-coordination/43-caller-custody") "\\.org\\'")))
  (dolist (file files)
    (with-current-buffer (find-file-noselect file)
      (org-export-to-file 'html (concat "/private/tmp/weaver-current-" (file-name-base file) ".html"))))
  (message "PASS: re-exported %d current Org documents without evaluating source blocks" (length files)))
