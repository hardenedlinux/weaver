# Shared presentation only. Semantic contracts remain in the owning Org files.
style.fill: "#ffffff"
classes: {
  semantic: {
    style: {
      fill: "#ffffff"
      stroke: "#16766b"
      font-color: "#15544c"
      border-radius: 5
      stroke-width: 1
    }
  }
  cloud: {
    style: {
      fill: "#ffffff"
      stroke: "#2774b8"
      font-color: "#174976"
      border-radius: 5
      stroke-width: 1
    }
  }
  runtime: {
    style: {
      fill: "#ffffff"
      stroke: "#6663b8"
      font-color: "#373479"
      border-radius: 5
      stroke-width: 1
    }
  }
  ledger: {
    style: {
      fill: "#ffffff"
      stroke: "#486783"
      font-color: "#26445f"
      border-radius: 5
      stroke-width: 1
    }
  }
  policy: {
    style: {
      fill: "#ffffff"
      stroke: "#6d83a1"
      font-color: "#334155"
      border-radius: 5
      stroke-width: 1
    }
  }
  deny: {
    style: {
      fill: "#fff0f1"
      stroke: "#bd4c60"
      font-color: "#823344"
      border-radius: 5
      stroke-width: 1
    }
  }
  unknown: {
    style: {
      fill: "#fff3e4"
      stroke: "#ba7d31"
      font-color: "#80521a"
      border-radius: 5
      stroke-width: 1
    }
  }
  verified: {
    style: {
      fill: "#ffffff"
      stroke: "#31856b"
      font-color: "#205d4c"
      border-radius: 5
      stroke-width: 1
    }
  }
  note: {
    style: {
      fill: "#f1f5f9"
      stroke: "#cbd5e1"
      font-color: "#475569"
      font-size: 14
    }
  }
  title: {
    shape: text
    style: {
      font-color: "#1e293b"
      font-size: 26
      bold: true
    }
  }
}
**.style.font-size: 16
(** -> **)[*].style: {
  stroke: "#718299"
  stroke-width: 1
  font-color: "#52647a"
  font-size: 14
}
