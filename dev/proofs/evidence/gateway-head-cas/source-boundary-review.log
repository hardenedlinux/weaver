9: structure Schedule (α : Type) where
10:   revision : Nat
11:   generation : Nat
12:   closed : Bool
13:   active : Option (Nat × α)
14:   pending : List (Nat × α)
15: 
16: def recover (s : Schedule α) : Option (Schedule α) :=
17:   if s.closed then none else
18:     some { s with revision := s.revision + 1, generation := s.generation + 1,
19:                   active := none, pending := s.active.toList ++ s.pending }
20: 
21: def complete [DecidableEq α] (s : Schedule α) (expectedRevision : Nat)
22:     (request : Nat × α) : Option (Schedule α) :=
23:   if s.revision = expectedRevision ∧ s.closed = false ∧ s.active = some request
24:   then some { s with revision := s.revision + 1, active := none }
25:   else none
26: 
31:   simp [recover, openState]
