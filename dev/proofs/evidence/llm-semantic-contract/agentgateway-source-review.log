26: impl NamespaceToolMap {
27: 	/// Rewrite namespace definitions, forced function choices, and function-call history
28: 	/// for Chat Completions and Bedrock Converse. Returns aliases for response restoration.
29: 	/// Bare choices must identify a unique member; qualified `namespace__function` names
30: 	/// are also accepted. Custom namespace members and allowed-tool constraints are unsupported.
31: 	/// On error the request may be partially rewritten and must be discarded.
32: 	pub fn rewrite_request(req: &mut responses::CreateResponse) -> Result<Self, AIError> {
33: 		let mut map = Self::default();
34: 		map.flatten_tools(&mut req.tools)?;
35: 		let mut names = HashSet::new();
36: 		for tool in req.tools.iter().flatten() {
37: 			if let responses::Tool::Function(function) = tool
38: 				&& !names.insert(function.name.as_str())
39: 			{
40: 				return Err(AIError::UnsupportedConversion(strng::format!(
41: 					"duplicate upstream tool name: {}",
42: 					function.name
43: 				)));
44: 			}
45: 		}
46: 		map.rewrite_choice(&mut req.tool_choice, &names)?;
47: 		map.rewrite_history(&mut req.input, &names)?;
48: 		Ok(map)
106: 		&self,
107: 		choice: &mut Option<responses::ToolChoiceParam>,
108: 		names: &HashSet<&str>,
109: 	) -> Result<(), AIError> {
110: 		// Neither target conversion can enforce an allowed-tools constraint.
111: 		if matches!(choice, Some(responses::ToolChoiceParam::AllowedTools(_))) {
112: 			return Err(AIError::UnsupportedConversion(strng::literal!(
113: 				"allowed_tools tool choice is unsupported for Chat Completions and Bedrock Converse"
114: 			)));
115: 		}
116: 
117: 		if let Some(responses::ToolChoiceParam::Function(choice)) = choice
118: 			&& !names.contains(choice.name.as_str())
119: 		{
120: 			let mut matches = self
121: 				.aliases
122: 				.iter()
123: 				.filter(|(_, original)| original.name == choice.name);
124: 			match (matches.next(), matches.next()) {
125: 				(Some((alias, _)), None) => choice.name = alias.clone(),
126: 				(Some(_), Some(_)) => {
127: 					return Err(AIError::UnsupportedConversion(strng::format!(
128: 						"ambiguous namespaced tool choice: {}; use namespace__function to select a member",
129: 						choice.name
130: 					)));
131: 				},
132: 				_ => {},
133: 			}
