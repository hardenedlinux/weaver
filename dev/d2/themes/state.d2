# State view: presentation only; no protocol or proof authority.
...@base
vars: { d2-config: { theme-id: 6; layout-engine: tala; pad: 64 } }
direction: right
style.fill: "#FBF9FE"
classes.card.style: { fill: "#F0E6FA"; stroke: "#7451A1"; font-color: "#7451A1"; border-radius: 30 }
classes.title.style.font-color: "#7451A1"
classes.ledger.style.border-radius: 30
classes.policy.style.border-radius: 30
classes.runtime.style.border-radius: 30
classes.semantic.style.border-radius: 30
classes.unknown.style.border-radius: 30

