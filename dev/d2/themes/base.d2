# Shared typography and semantic status colors only. Views choose their own profile.
classes: {
  column: { direction: down }
  row: { direction: right }
  semantic: { style: { fill: "#E5F5EE"; stroke: "#35846B"; font-color: "#195C49"; border-radius: 12; stroke-width: 1 } }
  cloud: { style: { fill: "#E8F2FC"; stroke: "#5486BB"; font-color: "#254D78"; border-radius: 12; stroke-width: 1 } }
  runtime: { style: { fill: "#EEEAF9"; stroke: "#8371B1"; font-color: "#514078"; border-radius: 12; stroke-width: 1 } }
  ledger: { style: { fill: "#EAF0F5"; stroke: "#6A8298"; font-color: "#334F67"; border-radius: 8; stroke-width: 1 } }
  policy: { style: { fill: "#FFF3DB"; stroke: "#BD9652"; font-color: "#73551F"; border-radius: 12; stroke-width: 1 } }
  deny: { style: { fill: "#FCE8EC"; stroke: "#B4546A"; font-color: "#83374B"; border-radius: 12; stroke-width: 2 } }
  unknown: { style: { fill: "#FFF0D9"; stroke: "#B88335"; font-color: "#79521C"; border-radius: 12; stroke-width: 2 } }
  verified: { style: { fill: "#E4F4E9"; stroke: "#4B9272"; font-color: "#275F46"; border-radius: 12; stroke-width: 1 } }
  note: { style: { fill: "#F0F3F7"; stroke: "#D3DBE4"; font-color: "#56657A"; font-size: 15; border-radius: 8 } }
  title: { shape: text; style: { font-color: "#24334E"; font-size: 30; bold: true } }
  card: { label.near: center-center; style: { font-size: 20; border-radius: 14; stroke-width: 1 } }
}
**.style.font-size: 17
(** -> **)[*].style: {
  stroke: "#7A8BA3"
  stroke-width: 1
  font-color: "#53667E"
  font-size: 15
}

