# Flow view: presentation only; no protocol or proof authority.
...@base
vars: { d2-config: { theme-id: 4; layout-engine: tala; pad: 64 } }
direction: right
style.fill: "#F7FCFA"
classes.card.style: { fill: "#E1F5F0"; stroke: "#087F8C"; font-color: "#087F8C"; border-radius: 20 }
classes.title.style.font-color: "#087F8C"

