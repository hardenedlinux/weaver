# System view: presentation only; no protocol or proof authority.
...@base
vars: { d2-config: { theme-id: 100; layout-engine: tala; pad: 64 } }
direction: right
style.fill: "#F7F9FC"
classes.card.style: { fill: "#EAF0FB"; stroke: "#273B73"; font-color: "#273B73"; border-radius: 14 }
classes.title.style.font-color: "#273B73"

