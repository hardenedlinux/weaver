;;; Reuse Agentic AI Lab's actual Profile and governor implementations.
(import (only-in :agentic-ai-lab/modules/loop-engine/control/governor loop-governor->contract)
        (only-in :agentic-ai-lab/modules/governance/funs agentic-ai-lab-governance-evaluate)
        (only-in :agentic-ai-lab/modules/governance/types agentic-ai-lab-governance-assessment?)
        (only-in :clan/poo/mop element?)
        (only-in :clan/poo/object .ref)
        "./types.ss" "./capture.ss")
(export assess-governance! governor-open-nodes)

(def (assess-governance! profile context blocking-threat?)
  (def original-profile (governance-profile-snapshot profile))
  (unless (and (element? GovernanceAssessmentContext context)
               (equal? (.ref context 'profile_identity) (.ref profile 'identity))
               (equal? (.ref context 'profile_revision) (.ref profile 'revision))
               (equal? (.ref context 'profile_owner) (.ref profile 'owner))
               (equal? (.ref context 'model_identity) (.ref (.ref profile 'threat-model) 'identity)))
    (error "Governance requires an exact source assessment context"))
  (let* ((model (.ref profile 'threat-model))
         (original-context (governance-context-snapshot context))
         (profile-method (.ref profile '.assess-governance))
         (model-method (.ref model '.assess-threats)))
    (when (ormap blocking-threat? (.ref model 'threats))
      (error "Scheme Governance assessment does not admit an inert source handoff"))
    (def assessment (agentic-ai-lab-governance-evaluate profile context))
    (unless (and (equal? original-profile (governance-profile-snapshot profile))
                 (equal? original-context (governance-context-snapshot context))
                 (eq? profile-method (.ref profile '.assess-governance))
                 (eq? model-method (.ref (.ref profile 'threat-model) '.assess-threats)))
      (error "Governance source changed during assessment"))
    (unless (and (agentic-ai-lab-governance-assessment? assessment)
                 (equal? (.ref assessment 'profile-identity) (.ref profile 'identity))
                 (equal? (.ref assessment 'model-identity) (.ref model 'identity))
                 (equal? (.ref assessment 'assessed-threats) (.ref model 'threats))
                 (not (ormap blocking-threat? (.ref model 'threats)))
                 (element? GovernanceAssessmentContext (.ref assessment 'context))
                 (equal? original-context (governance-context-snapshot (.ref assessment 'context)))
                 (.ref assessment 'handoff-ready?)
                 (not (.ref assessment 'runtime-executed?)))
      (error "Scheme Governance assessment does not admit an inert source handoff")))
  #t)

(def (governor-open-nodes governor states)
  (let ((contract (loop-governor->contract governor states)))
    (map symbol->string (cdr (assq 'open-patterns contract)))))
